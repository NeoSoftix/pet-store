{%- style -%}
  .pet-custom-footer {
    position: relative;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #4b5563;
    overflow: hidden;
  }

  .pet-custom-footer-main {
    background-image: url('{{ "footer.png" | asset_url }}');
    background-size: cover;
    background-position: center top;
    background-repeat: no-repeat;
    padding-top: 10rem;
    padding-bottom: 8rem;
  }

  .pet-footer-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 0 2.4rem;
  }

  .pet-footer-grid {
    display: grid;
    grid-template-columns: 1.3fr 0.8fr 0.9fr 1.2fr;
    gap: 4rem;
  }

  /* BRAND COLUMN */
  .pet-footer-brand-logo {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 2rem;
    text-decoration: none;
  }

  .pet-footer-logo-icon {
    width: 4.4rem;
    height: 4.4rem;
    background-color: #4c46c4;
    color: #ffffff;
    border-radius: 1.2rem;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 4px 12px rgba(76, 70, 196, 0.3);
  }

  .pet-footer-brand-name {
    font-size: 2.6rem;
    font-weight: 900;
    color: #111827;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .pet-footer-brand-name span {
    display: block;
    font-size: 1.2rem;
    font-weight: 800;
    color: #4c46c4;
    letter-spacing: 0.25em;
    margin-top: 0.4rem;
  }

  .pet-footer-about-text {
    font-size: 1.45rem;
    line-height: 1.6;
    color: #4b5563;
    margin-bottom: 2.4rem;
    max-width: 340px;
  }

  .pet-footer-contact-list {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
    margin-bottom: 2.4rem;
  }

  .pet-footer-contact-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.4rem;
    color: #374151;
    font-weight: 600;
  }

  .pet-footer-contact-item svg {
    color: #4c46c4;
    flex-shrink: 0;
  }

  .pet-footer-socials {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pet-footer-social-btn {
    width: 3.8rem;
    height: 3.8rem;
    border-radius: 50%;
    border: 1px solid #c7d2fe;
    background-color: #ffffff;
    color: #4c46c4;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .pet-footer-social-btn:hover {
    background-color: #4c46c4;
    color: #ffffff;
    border-color: #4c46c4;
    transform: translateY(-2px);
    box-shadow: 0 4px 12px rgba(76, 70, 196, 0.25);
  }

  /* COLUMN HEADINGS */
  .pet-footer-heading {
    font-size: 1.5rem;
    font-weight: 800;
    color: #4c46c4;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    margin: 0 0 1.6rem 0;
    position: relative;
    padding-bottom: 0.8rem;
  }

  .pet-footer-heading::after {
    content: '';
    position: absolute;
    bottom: 0;
    left: 0;
    width: 3rem;
    height: 3px;
    background-color: #4c46c4;
    border-radius: 2px;
  }

  /* LINKS LIST */
  .pet-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .pet-footer-link-item a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 1.45rem;
    font-weight: 600;
    color: #374151;
    text-decoration: none;
    transition: color 0.2s ease, transform 0.2s ease;
  }

  .pet-footer-link-item a:hover {
    color: #4c46c4;
    transform: translateX(4px);
  }

  .pet-footer-link-arrow {
    color: #4c46c4;
    font-weight: 800;
  }

  /* NEWSLETTER BOX */
  .pet-footer-newsletter-sub {
    font-size: 1.45rem;
    color: #4b5563;
    line-height: 1.5;
    margin-bottom: 2rem;
  }

  .pet-footer-form-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background-color: #ffffff;
    border: 1px solid #c7d2fe;
    border-radius: 3rem;
    padding: 0.4rem 0.4rem 0.4rem 1.6rem;
    box-shadow: 0 4px 14px rgba(76, 70, 196, 0.08);
  }

  .pet-footer-input {
    width: 100%;
    border: none;
    background: transparent;
    font-size: 1.4rem;
    color: #111827;
    outline: none;
  }

  .pet-footer-submit-btn {
    padding: 1rem 2rem;
    border-radius: 2.5rem;
    background-color: #4c46c4;
    color: #ffffff;
    border: none;
    font-size: 1.4rem;
    font-weight: 700;
    cursor: pointer;
    display: flex;
    align-items: center;
    gap: 0.6rem;
    transition: all 0.2s ease;
    white-space: nowrap;
    box-shadow: 0 4px 12px rgba(76, 70, 196, 0.3);
  }

  .pet-footer-submit-btn:hover {
    background-color: #3b35ad;
    transform: translateY(-1px);
  }

  /* FLOATING FEATURES BAR */
  .pet-footer-features-bar {
    max-width: 1200px;
    margin: -5rem auto 0 auto;
    position: relative;
    z-index: 10;
    background-color: #ffffff;
    border-radius: 2rem;
    box-shadow: 0 12px 36px rgba(0, 0, 0, 0.06);
    padding: 2.4rem 3rem;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 2rem;
    border: 1px solid #f0f0f4;
  }

  .pet-footer-feature-col {
    display: flex;
    align-items: center;
    gap: 1.6rem;
    position: relative;
  }

  .pet-footer-feature-col:not(:last-child)::after {
    content: '';
    position: absolute;
    right: -1rem;
    top: 15%;
    bottom: 15%;
    width: 1px;
    background-color: #e5e7eb;
  }

  .pet-footer-feature-icon-box {
    width: 4.8rem;
    height: 4.8rem;
    border-radius: 50%;
    background-color: #4c46c4;
    color: #ffffff;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    box-shadow: 0 4px 12px rgba(76, 70, 196, 0.25);
  }

  .pet-footer-feature-title {
    font-size: 1.5rem;
    font-weight: 800;
    color: #111827;
    margin: 0 0 0.3rem 0;
  }

  .pet-footer-feature-desc {
    font-size: 1.25rem;
    color: #6b7280;
    margin: 0;
    line-height: 1.35;
  }

  /* BOTTOM COPYRIGHT BAR */
  .pet-footer-bottom {
    background-color: #4c46c4;
    padding: 4rem 2.4rem 2.4rem 2.4rem;
    color: #ffffff;
  }

  .pet-footer-bottom-container {
    max-width: 1300px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    font-size: 1.35rem;
  }

  .pet-footer-copyright-text {
    opacity: 0.9;
    font-weight: 500;
  }

  .pet-footer-policy-links {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .pet-footer-policy-links a {
    color: #ffffff;
    text-decoration: none;
    opacity: 0.9;
    font-weight: 500;
    transition: opacity 0.2s ease;
  }

  .pet-footer-policy-links a:hover {
    opacity: 1;
    text-decoration: underline;
  }

  @media screen and (max-width: 989px) {
    .pet-footer-grid {
      grid-template-columns: repeat(2, 1fr);
    }
    .pet-footer-features-bar {
      grid-template-columns: repeat(2, 1fr);
      margin-top: -3rem;
    }
    .pet-footer-feature-col:nth-child(2)::after {
      display: none;
    }
  }

  @media screen and (max-width: 576px) {
    .pet-footer-grid {
      grid-template-columns: 1fr;
    }
    .pet-footer-features-bar {
      grid-template-columns: 1fr;
    }
    .pet-footer-feature-col::after {
      display: none;
    }
    .pet-footer-bottom-container {
      flex-direction: column;
      text-align: center;
    }
  }
{%- endstyle -%}

