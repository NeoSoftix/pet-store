{%- style -%}
  .pet-custom-footer {
    background-color: #f6f4fc;
    color: #1e1b3a;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .pet-footer-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 6rem 2.4rem 3rem 2.4rem;
  }

  .pet-footer-grid {
    display: grid;
    grid-template-columns: 1.4fr 0.9fr 1fr 1fr 1.1fr;
    gap: 3.2rem;
  }

  /* BRAND COLUMN */
  .pet-footer-brand-logo {
    display: flex;
    align-items: center;
    margin-bottom: 1.8rem;
    text-decoration: none;
  }

  .pet-footer-logo-img {
    height: 3.6rem;
    width: auto;
    display: block;
  }

  .pet-footer-about-text {
    font-size: 1.4rem;
    line-height: 1.6;
    color: #6b667f;
    margin-bottom: 2.4rem;
    max-width: 300px;
  }

  .pet-footer-socials {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pet-footer-social-btn {
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    border: 1px solid #ded9f7;
    background-color: transparent;
    color: #4c46c4;
    display: flex;
    align-items: center;
    justify-content: center;
    text-decoration: none;
    transition: all 0.2s ease;
  }

  .pet-footer-social-btn:hover {
    background-color: #4c46c4;
    color: #ffffff;
    border-color: #4c46c4;
  }

  /* COLUMN HEADINGS */
  .pet-footer-heading {
    font-size: 1.4rem;
    font-weight: 800;
    color: #1e1b3a;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    margin: 0 0 1.8rem 0;
  }

  /* LINKS LIST */
  .pet-footer-links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .pet-footer-link-item a {
    font-size: 1.4rem;
    font-weight: 500;
    color: #6b667f;
    text-decoration: none;
    transition: color 0.2s ease;
  }

  .pet-footer-link-item a:hover {
    color: #4c46c4;
  }

  /* NEWSLETTER */
  .pet-footer-newsletter-sub {
    font-size: 1.35rem;
    color: #6b667f;
    line-height: 1.5;
    margin-bottom: 1.6rem;
  }

  .pet-footer-form-wrapper {
    position: relative;
    display: flex;
    align-items: center;
    background-color: #ffffff;
    border: 1px solid #ded9f7;
    border-radius: 3rem;
    padding: 0.4rem 0.4rem 0.4rem 1.6rem;
  }

  .pet-footer-input {
    width: 100%;
    border: none;
    background: transparent;
    font-size: 1.3rem;
    color: #1e1b3a;
    outline: none;
  }

  .pet-footer-submit-btn {
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    background-color: #4c46c4;
    color: #ffffff;
    border: none;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
    transition: background 0.2s ease;
  }

  .pet-footer-submit-btn:hover {
    background-color: #3b35ad;
  }

  /* BOTTOM COPYRIGHT BAR */
  .pet-footer-bottom {
    border-top: 1px solid #ded9f7;
  }

  .pet-footer-bottom-container {
    max-width: 1300px;
    margin: 0 auto;
    padding: 2.4rem 2.4rem;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
    font-size: 1.3rem;
  }

  .pet-footer-copyright-text {
    color: #6b667f;
    font-weight: 500;
  }

  .pet-footer-dev-link {
    color: #4c46c4;
    font-weight: 700;
    text-decoration: none;
  }

  .pet-footer-dev-link:hover {
    text-decoration: underline;
  }

  .pet-footer-legal-links {
    display: flex;
    align-items: center;
    gap: 2rem;
  }

  .pet-footer-legal-links a {
    color: #6b667f;
    font-size: 1.3rem;
    font-weight: 500;
    text-decoration: none;
  }

  .pet-footer-legal-links a:hover {
    color: #4c46c4;
    text-decoration: underline;
  }

  @media screen and (max-width: 989px) {
    .pet-footer-container {
      padding: 4.8rem 2.4rem 2.4rem;
    }

    .pet-footer-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 3.2rem 2.4rem;
    }
  }

  @media screen and (max-width: 749px) {
    .pet-footer-grid {
      grid-template-columns: 1fr;
      gap: 3.2rem;
    }

    .pet-footer-bottom-container {
      flex-direction: column;
      text-align: center;
      gap: 1.6rem;
    }

    .pet-footer-about-text {
      max-width: 100%;
    }

    .pet-footer-legal-links {
      flex-wrap: wrap;
      justify-content: center;
    }
  }

  @media screen and (max-width: 480px) {
    .pet-footer-container {
      padding: 3.6rem 1.6rem 1.6rem;
    }

    .pet-footer-bottom-container {
      padding: 2rem 1.6rem;
    }

    .pet-footer-heading {
      font-size: 1.3rem;
      margin-bottom: 1.4rem;
    }

    .pet-footer-about-text,
    .pet-footer-link-item a,
    .pet-footer-newsletter-sub {
      font-size: 1.3rem;
    }

    .pet-footer-social-btn {
      width: 4rem;
      height: 4rem;
    }

    .pet-footer-form-wrapper {
      padding: 0.4rem 0.4rem 0.4rem 1.2rem;
    }

    .pet-footer-submit-btn {
      width: 4rem;
      height: 4rem;
    }

    .pet-footer-legal-links {
      gap: 1.4rem;
    }

    .pet-footer-legal-links a {
      font-size: 1.2rem;
    }
  }
{%- endstyle -%}

<footer class="pet-custom-footer">
  <div class="pet-footer-container">
    <div class="pet-footer-grid">

      <!-- COLUMN 1: BRAND -->
      <div>
        <a href="/" class="pet-footer-brand-logo">
          <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" class="pet-footer-logo-img">
        </a>

        <p class="pet-footer-about-text">
          {{ 'custom.footer.about_text' | t }}
        </p>

        <div class="pet-footer-socials">
          <a href="#" class="pet-footer-social-btn" aria-label="{{ 'custom.footer.aria_social_facebook' | t }}">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"/></svg>
          </a>
          <a href="#" class="pet-footer-social-btn" aria-label="{{ 'custom.footer.aria_social_instagram' | t }}">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"/></svg>
          </a>
          <a href="#" class="pet-footer-social-btn" aria-label="{{ 'custom.footer.aria_social_tiktok' | t }}">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M12.525.02c1.31-.02 2.61-.01 3.91-.02.08 1.53.63 3.09 1.75 4.17 1.12 1.11 2.7 1.62 4.24 1.79v4.03c-1.44-.05-2.89-.35-4.2-.97-.57-.26-1.1-.59-1.62-.93-.01 2.92.01 5.84-.02 8.75-.08 1.4-.54 2.79-1.35 3.94-1.31 1.92-3.58 3.17-5.91 3.21-1.43.08-2.86-.31-4.08-1.03-2.02-1.19-3.44-3.37-3.65-5.71-.29-2.73.91-5.46 3.08-7.1 1.53-1.17 3.49-1.74 5.41-1.57.04 1.39.02 2.78.02 4.17-1.16-.13-2.35.19-3.27.87-.96.69-1.54 1.83-1.52 3.01.03 1.25.68 2.42 1.74 3.08 1.05.67 2.42.76 3.56.24 1.07-.46 1.85-1.47 1.99-2.63.07-2.6.02-5.2.03-7.8.01-4.8.01-9.6.01-14.4z"/></svg>
          </a>
          <a href="#" class="pet-footer-social-btn" aria-label="{{ 'custom.footer.aria_social_youtube' | t }}">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="currentColor"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.33z"/><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02" fill="#ffffff"/></svg>
          </a>
        </div>
      </div>

      <!-- COLUMN 2: SHOP -->
      <div>
        <h3 class="pet-footer-heading">{{ 'custom.footer.shop_heading' | t }}</h3>
        <ul class="pet-footer-links">
          <li class="pet-footer-link-item"><a href="/collections/all">{{ 'custom.footer.shop_all_products' | t }}</a></li>
          <li class="pet-footer-link-item"><a href="/collections/dog">{{ 'custom.footer.shop_dog' | t }}</a></li>
          <li class="pet-footer-link-item"><a href="/collections/cat">{{ 'custom.footer.shop_cat' | t }}</a></li>
          <li class="pet-footer-link-item"><a href="/collections/all">{{ 'custom.footer.shop_supplements' | t }}</a></li>
        </ul>
      </div>

      <!-- COLUMN 3: CUSTOMER CARE -->
      <div>
        <h3 class="pet-footer-heading">{{ 'custom.footer.customer_care_heading' | t }}</h3>
        <ul class="pet-footer-links">
          <li class="pet-footer-link-item"><a href="/account">{{ 'custom.footer.customer_care_my_account' | t }}</a></li>
          <li class="pet-footer-link-item"><a href="/policies/shipping-policy">{{ 'custom.footer.customer_care_shipping' | t }}</a></li>
          <li class="pet-footer-link-item"><a href="/policies/refund-policy">{{ 'custom.footer.customer_care_returns' | t }}</a></li>
          <li class="pet-footer-link-item"><a href="/pages/contact">{{ 'custom.footer.customer_care_contact' | t }}</a></li>
        </ul>
      </div>

      <!-- COLUMN 4: ABOUT -->
      <div>
        <h3 class="pet-footer-heading">{{ 'custom.footer.about_heading' | t }}</h3>
        <ul class="pet-footer-links">
          <li class="pet-footer-link-item"><a href="/pages/about-us">{{ 'custom.footer.about_our_story' | t }}</a></li>
          <li class="pet-footer-link-item"><a href="/pages/about-us">{{ 'custom.footer.about_why_petvona' | t }}</a></li>
          <li class="pet-footer-link-item"><a href="/pages/about-us">{{ 'custom.footer.about_sustainability' | t }}</a></li>
          <li class="pet-footer-link-item"><a href="/blogs/news">{{ 'custom.footer.about_blog' | t }}</a></li>
        </ul>
      </div>

      <!-- COLUMN 5: NEWSLETTER -->
      <div>
        <h3 class="pet-footer-heading">{{ 'custom.footer.newsletter_heading' | t }}</h3>
        <p class="pet-footer-newsletter-sub">{{ 'custom.footer.newsletter_sub' | t }}</p>
        <form action="/contact#contact_form" method="post" class="pet-footer-form-wrapper">
          <input type="hidden" name="form_type" value="customer">
          <input type="hidden" name="utf8" value="✓">
          <input type="email" name="contact[email]" class="pet-footer-input" placeholder="{{ 'custom.footer.newsletter_placeholder' | t }}" required>
          <button type="submit" class="pet-footer-submit-btn" aria-label="{{ 'custom.footer.newsletter_submit' | t }}">
            <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
          </button>
        </form>
      </div>

    </div>
  </div>

  <!-- BOTTOM COPYRIGHT BAR -->
  <div class="pet-footer-bottom">
    <div class="pet-footer-bottom-container">
      <div class="pet-footer-copyright-text">
        © 2026 Petvona. {{ 'custom.footer.developed_by' | t }} <a href="https://neosoftix.com" target="_blank" rel="noopener noreferrer" class="pet-footer-dev-link">Neosoftix</a>. {{ 'custom.footer.all_rights_reserved' | t }}
      </div>
      <div class="pet-footer-legal-links">
        <a href="/pages/privacy-policy">{{ 'custom.footer.privacy_policy' | t }}</a>
        <a href="/pages/terms-conditions">{{ 'custom.footer.terms_conditions' | t }}</a>
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "Custom Pet Footer",
  "settings": []
}
{% endschema %}
