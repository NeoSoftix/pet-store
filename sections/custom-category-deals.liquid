{%- style -%}
  .pet-category-deals-section {
    padding: 3.5rem 1.5rem 4rem;
    background-color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .pet-category-deals-container {
    max-width: 1360px;
    margin: 0 auto;
  }

  /* --- Header --- */
  .pet-deals-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .pet-deals-header__paw-top {
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.4rem;
  }

  .pet-deals-header__paw-top svg {
    width: 28px;
    height: 28px;
    fill: #2d6a4f;
    opacity: 0.8;
  }

  .pet-category-deals-title {
    font-size: 3.8rem;
    font-weight: 900;
    color: #111827;
    text-align: center;
    margin: 0 0 0.5rem 0;
    letter-spacing: -0.03em;
    line-height: 1.1;
  }

  .pet-deals-header__subtitle {
    font-size: 1.25rem;
    color: #4b5563;
    margin-bottom: 1rem;
    font-weight: 500;
  }

  .pet-deals-header__divider {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
  }

  .pet-deals-header__divider-line {
    width: 60px;
    height: 3px;
    border-radius: 3px;
    background: linear-gradient(90deg, #2d6a4f, #40916c);
  }

  .pet-deals-header__divider svg {
    width: 18px;
    height: 18px;
    fill: #2d6a4f;
  }

  /* --- Grid --- */
  .pet-deals-grid {
    display: grid;
    grid-template-columns: 1fr 1.2fr 1fr;
    grid-template-rows: 1fr 1fr;
    gap: 1.4rem;
  }

  /* --- Card --- */
  .pet-deal-card {
    border-radius: 1.25rem;
    padding: 2.2rem 2rem;
    position: relative;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    justify-content: flex-start;
    transition: transform 0.3s ease, box-shadow 0.3s ease;
    text-decoration: none;
    min-height: 280px;
    cursor: pointer;
  }

  .pet-deal-card:hover {
    transform: translateY(-5px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.09);
  }

  .pet-deal-card--large {
    grid-row: 1 / 3;
    grid-column: 1;
    padding: 2.5rem 2.2rem;
  }

  /* --- Card Content --- */
  .pet-deal-card__content {
    position: relative;
    z-index: 3;
    max-width: 48%;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    flex: 1;
  }

  .pet-deal-card--large .pet-deal-card__content {
    max-width: 46%;
  }

  /* --- Badge --- */
  .pet-deal-card__badge {
    display: inline-flex;
    align-items: center;
    padding: 0.5rem 1.2rem;
    border-radius: 2rem;
    font-size: 0.82rem;
    font-weight: 800;
    text-transform: uppercase;
    color: #ffffff;
    margin-bottom: 1.2rem;
    letter-spacing: 0.06em;
  }

  /* --- Icon Circle --- */
  .pet-deal-card__icon-wrap {
    width: 46px;
    height: 46px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    margin-bottom: 0.8rem;
  }

  .pet-deal-card__icon-wrap svg {
    width: 22px;
    height: 22px;
  }

  /* --- Tagline --- */
  .pet-deal-card__tagline {
    font-size: 0.9rem;
    font-weight: 800;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    margin-bottom: 0.4rem;
  }

  /* --- Title --- */
  .pet-deal-card__title {
    font-size: 2.6rem;
    font-weight: 800;
    color: #111827;
    margin: 0 0 0.5rem 0;
    line-height: 1.12;
  }

  .pet-deal-card--large .pet-deal-card__title {
    font-size: 3.6rem;
  }

  /* --- Description --- */
  .pet-deal-card__desc {
    font-size: 1.2rem;
    color: #374151;
    margin-bottom: 1.6rem;
    line-height: 1.4;
    font-weight: 500;
  }

  /* --- CTA Button --- */
  .pet-deal-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.6rem;
    border-radius: 2rem;
    font-size: 1rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.3s ease;
    margin-top: auto;
    border: none;
    cursor: pointer;
  }

  .pet-deal-btn__arrow {
    transition: transform 0.3s ease;
    display: inline-block;
  }

  .pet-deal-card:hover .pet-deal-btn__arrow {
    transform: translateX(5px);
  }

  /* --- Card Image: Clean 50% split on right side with soft ambient shade --- */
  .pet-deal-card__img {
    position: absolute;
    top: 0;
    bottom: 0;
    right: 0;
    width: 52%;
    height: 100%;
    object-fit: cover;
    object-position: center center;
    z-index: 1;
    transition: transform 0.5s ease;
    box-shadow: -10px 0 24px rgba(0, 0, 0, 0.07);
  }

  /* Soft edge shade where text meets image */
  .pet-deal-card::before {
    content: '';
    position: absolute;
    top: 0;
    bottom: 0;
    right: 52%;
    width: 20px;
    background: linear-gradient(to right, rgba(0,0,0,0), rgba(0,0,0,0.04));
    z-index: 2;
    pointer-events: none;
  }

  .pet-deal-card:hover .pet-deal-card__img {
    transform: scale(1.04);
  }

  .pet-deal-card--large .pet-deal-card__img {
    width: 54%;
    object-position: 25% center;
  }
  .pet-deal-card--large::before {
    right: 54%;
  }

  /* ============================================
     COLOR THEMES
     ============================================ */

  /* 1. Raw Food */
  .pet-deal-card--theme-raw { background-color: #fdf5ee; }
  .pet-deal-card--theme-raw .pet-deal-card__badge { background-color: #f97316; }
  .pet-deal-card--theme-raw .pet-deal-btn {
    background-color: #ffffff;
    color: #f97316;
    border: 2px solid #f97316;
  }
  .pet-deal-card--theme-raw .pet-deal-btn:hover {
    background-color: #f97316;
    color: #ffffff;
  }

  /* 2. Wet Food */
  .pet-deal-card--theme-wet { background-color: #f0faf5; }
  .pet-deal-card--theme-wet .pet-deal-card__icon-wrap { background-color: #d4f0e2; }
  .pet-deal-card--theme-wet .pet-deal-card__icon-wrap svg { color: #2d6a4f; fill: none; stroke: #2d6a4f; }
  .pet-deal-card--theme-wet .pet-deal-card__tagline { color: #2d6a4f; }
  .pet-deal-card--theme-wet .pet-deal-btn { background-color: #2d6a4f; color: #ffffff; }
  .pet-deal-card--theme-wet .pet-deal-btn:hover { background-color: #245a42; }

  /* 3. Dry Food */
  .pet-deal-card--theme-dry { background-color: #fff6f0; }
  .pet-deal-card--theme-dry .pet-deal-card__icon-wrap { background-color: #ffe4cc; }
  .pet-deal-card--theme-dry .pet-deal-card__icon-wrap svg { color: #e85d04; fill: none; stroke: #e85d04; }
  .pet-deal-card--theme-dry .pet-deal-card__tagline { color: #e85d04; }
  .pet-deal-card--theme-dry .pet-deal-btn { background-color: #e85d04; color: #ffffff; }
  .pet-deal-card--theme-dry .pet-deal-btn:hover { background-color: #cc5003; }

  /* 4. Natural Ingredients */
  .pet-deal-card--theme-natural { background-color: #f0faf5; }
  .pet-deal-card--theme-natural .pet-deal-card__icon-wrap { background-color: #d4f0e2; }
  .pet-deal-card--theme-natural .pet-deal-card__icon-wrap svg { color: #2d6a4f; fill: none; stroke: #2d6a4f; }
  .pet-deal-card--theme-natural .pet-deal-card__tagline { color: #2d6a4f; }
  .pet-deal-card--theme-natural .pet-deal-btn { background-color: #2d6a4f; color: #ffffff; }
  .pet-deal-card--theme-natural .pet-deal-btn:hover { background-color: #245a42; }

  /* 5. Freeze & Air Dried */
  .pet-deal-card--theme-freeze { background-color: #f5f2fb; }
  .pet-deal-card--theme-freeze .pet-deal-card__icon-wrap { background-color: #e6e0f4; }
  .pet-deal-card--theme-freeze .pet-deal-card__icon-wrap svg { color: #7c3aed; fill: none; stroke: #7c3aed; }
  .pet-deal-card--theme-freeze .pet-deal-card__tagline { color: #7c3aed; }
  .pet-deal-card--theme-freeze .pet-deal-btn { background-color: #7c3aed; color: #ffffff; }
  .pet-deal-card--theme-freeze .pet-deal-btn:hover { background-color: #6d28d9; }

  /* ============================================
     RESPONSIVE
     ============================================ */
  @media screen and (max-width: 1024px) {
    .pet-deals-grid {
      grid-template-columns: 1fr 1fr;
      grid-template-rows: auto;
    }
    .pet-deal-card--large {
      grid-column: 1 / -1;
      grid-row: auto;
      min-height: 320px;
    }
    .pet-deal-card__content { max-width: 50% !important; }
  }

  @media screen and (max-width: 768px) {
    .pet-category-deals-section { padding: 2.5rem 1.2rem 3rem; }
    .pet-category-deals-title { font-size: 2.6rem; }
    .pet-deals-grid { grid-template-columns: 1fr; }
    .pet-deal-card--large { min-height: 320px; }
    .pet-deal-card { min-height: 260px; }
    .pet-deal-card__content { max-width: 55% !important; }
    .pet-deal-card__img { width: 50% !important; }
    .pet-deal-card--large .pet-deal-card__title { font-size: 2.8rem; }
  }

  @media screen and (max-width: 480px) {
    .pet-deal-card__content { max-width: 100% !important; }
    .pet-deal-card__img {
      position: relative;
      top: auto; bottom: auto; right: auto;
      width: 100% !important;
      height: 200px;
      margin-top: 1rem;
    }
    .pet-deal-card { min-height: auto; padding: 1.6rem 1.4rem; }
  }
{%- endstyle -%}

