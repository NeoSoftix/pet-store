{%- style -%}
  #shopify-section-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .pet-header-sticky-wrapper {
    position: relative;
    z-index: 1;
  }

  .pet-main-header {
    background-color: {{ section.settings.header_bg | default: '#ffffff' }};
    border-bottom: 1px solid {{ section.settings.border_color | default: '#f0f0f4' }};
    position: relative;
    z-index: 1001;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  .pet-main-header__container {
    max-width: {{ section.settings.container_width | default: 1400 }}px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.6rem 2.4rem;
    gap: 2rem;
    position: relative;
  }

  .pet-main-header__left {
    display: flex;
    align-items: center;
    gap: 4rem;
    min-width: 0;
  }

  .pet-main-header__nav {
    display: flex;
    align-items: center;
    gap: 2.8rem;
  }

  .pet-nav-item {
    position: relative;
  }

  .pet-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: {{ section.settings.nav_color | default: '#111827' }};
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 600;
    padding: 0.8rem 0;
    transition: color 0.15s ease;
    cursor: pointer;
    background: none;
    border: none;
  }

  .pet-nav-link:hover {
    color: #5b4fe0;
  }

  .pet-nav-link.is-active {
    color: #5b4fe0;
    border-bottom: 2.5px solid #5b4fe0;
    padding-bottom: 0.4rem;
  }

  .pet-search-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    background-color: #5b4fe0;
    color: #ffffff;
    padding: 0.8rem 1.8rem;
    border-radius: 2rem;
    font-size: 1.3rem;
    font-weight: 700;
    text-decoration: none;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(91, 79, 224, 0.25);
  }

  .pet-search-btn:hover {
    background-color: #483cc9;
    box-shadow: 0 6px 16px rgba(91, 79, 224, 0.35);
  }

  .pet-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: #ffffff;
    border: 1px solid #f0f0f4;
    border-radius: 1.2rem;
    padding: 1.2rem 0;
    min-width: 200px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1050;
  }

  .pet-nav-item:hover .pet-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .pet-dropdown-menu a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.8rem;
    color: #374151;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 500;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .pet-dropdown-menu a:hover {
    background: #f3f1fd;
    color: #4c46c4;
  }

  .pet-main-header__brand {
    display: flex;
    align-items: center;
  }

  .pet-main-header__logo {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .pet-logo-img {
    height: 3.6rem;
    width: auto;
    display: block;
    max-width: 100%;
  }

  .pet-main-header__actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-shrink: 0;
  }

  .pet-lang-switcher {
    position: relative;
  }

  .pet-lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.25rem;
    font-weight: 600;
    color: #6b7280;
    padding: 0;
  }

  .pet-lang-toggle:hover {
    color: #4c46c4;
  }

  .pet-lang-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.8rem;
    background: #ffffff;
    border-radius: 0.8rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    list-style: none;
    padding: 0.6rem 0;
    min-width: 140px;
    z-index: 1100;
  }

  .pet-lang-dropdown a {
    display: block;
    padding: 0.6rem 1.4rem;
    color: #374151;
    font-size: 1.3rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .pet-lang-dropdown a:hover,
  .pet-lang-dropdown a.is-active {
    background: #f3f1fd;
    color: #4c46c4;
  }

  .pet-action-icon-btn {
    background: none;
    border: none;
    color: #111827;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem;
    border-radius: 50%;
    transition: background-color 0.15s ease, color 0.15s ease;
    text-decoration: none;
    position: relative;
  }

  .pet-action-icon-btn:hover {
    background-color: #f3f4f6;
    color: #4c46c4;
  }

  .pet-cart-count {
    position: absolute;
    top: -0.2rem;
    right: -0.2rem;
    background-color: #4c46c4;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pet-mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: #111827;
    cursor: pointer;
    padding: 1rem;
    align-items: center;
    justify-content: center;
    min-width: 4.4rem;
    min-height: 4.4rem;
    border-radius: 0.6rem;
  }

  .pet-mobile-toggle:hover {
    background-color: #f3f4f6;
  }

  /* TABLET & MOBILE (<=989px): hide inline nav, show hamburger toggle */
  @media screen and (max-width: 989px) {
    .pet-main-header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background-color: {{ section.settings.header_bg | default: '#ffffff' }};
      border-bottom: 1px solid {{ section.settings.border_color | default: '#f0f0f4' }};
      box-shadow: 0 16px 24px rgba(0, 0, 0, 0.08);
      padding: 0.8rem 2.4rem 1.6rem;
      z-index: 1002;
    }

    .pet-main-header__nav.is-open {
      display: flex;
    }

    .pet-nav-item {
      width: 100%;
    }

    .pet-nav-link {
      width: 100%;
      padding: 1.2rem 0;
      font-size: 1.6rem;
      min-height: 4.4rem;
    }

    .pet-dropdown-menu {
      position: static;
      display: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      border-radius: 0;
      padding: 0 0 0 1.6rem;
      min-width: 0;
      width: 100%;
    }

    .pet-nav-item:hover .pet-dropdown-menu {
      transform: none;
    }

    .pet-mobile-toggle {
      display: flex;
    }
  }

  /* TABLET (750px-989px) */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .pet-main-header__container {
      padding: 1.6rem 3.2rem;
    }
  }

  /* MOBILE (<=749px) */
  @media screen and (max-width: 749px) {
    .pet-main-header__container {
      padding: 1.2rem 1.6rem;
      gap: 1.2rem;
    }

    .pet-main-header__left {
      gap: 1.2rem;
    }

    .pet-logo-img {
      height: 2.8rem;
    }

    .pet-main-header__actions {
      gap: 0.8rem;
    }

    .pet-lang-toggle span {
      max-width: 6rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .pet-action-icon-btn {
      padding: 1rem;
      min-width: 4.2rem;
      min-height: 4.2rem;
    }
  }

  /* SMALL PHONES (<=480px) */
  @media screen and (max-width: 480px) {
    .pet-main-header__container {
      padding: 1rem 1.2rem;
      gap: 0.8rem;
    }

    .pet-main-header__left {
      gap: 0.8rem;
    }

    .pet-logo-img {
      height: 2.4rem;
    }

    .pet-main-header__actions {
      gap: 0.4rem;
    }

    .pet-mobile-toggle {
      min-width: 4rem;
      min-height: 4rem;
      padding: 0.8rem;
    }

    .pet-lang-toggle {
      font-size: 1.15rem;
    }

    .pet-lang-toggle span {
      max-width: 4.4rem;
    }

    .pet-lang-dropdown {
      right: -1rem;
      min-width: 120px;
    }

    .pet-cart-count {
      width: 1.6rem;
      height: 1.6rem;
      font-size: 0.9rem;
    }
  }

  /* ===== CART DRAWER ===== */
  .pv-cart-drawer-overlay {
    position: fixed;
    inset: 0;
    background: rgba(20, 16, 48, 0.45);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    z-index: 998;
  }

  .pv-cart-drawer-overlay.is-active {
    opacity: 1;
    visibility: visible;
  }

  .pv-cart-drawer {
    position: fixed;
    top: 0;
    right: 0;
    height: 100%;
    width: 40rem;
    max-width: 92vw;
    background: #ffffff;
    z-index: 999;
    display: flex;
    flex-direction: column;
    transform: translateX(100%);
    transition: transform 0.3s ease;
    box-shadow: -8px 0 30px rgba(20, 16, 48, 0.15);
  }

  .pv-cart-drawer.is-active {
    transform: translateX(0);
  }

  .pv-cart-drawer__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.8rem 2rem;
    border-bottom: 1px solid #f0eefa;
  }

  .pv-cart-drawer__title {
    font-size: 1.8rem;
    font-weight: 800;
    margin: 0;
  }

  .pv-cart-drawer__close {
    width: 3.2rem;
    height: 3.2rem;
    border-radius: 50%;
    border: none;
    background: #f6f4fc;
    color: #1e1b3a;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    flex-shrink: 0;
  }

  .pv-cart-drawer__body {
    flex: 1;
    overflow-y: auto;
    padding: 0.4rem 2rem;
  }

  .pv-cart-drawer__empty {
    text-align: center;
    padding: 4rem 1rem;
    color: #6b667f;
    font-size: 1.5rem;
  }

  .pv-cart-drawer__item {
    display: flex;
    gap: 1.2rem;
    padding: 1.4rem 0;
    border-bottom: 1px solid #f0eefa;
  }

  .pv-cart-drawer__item-img {
    width: 7rem;
    height: 7rem;
    border-radius: 1rem;
    overflow: hidden;
    background: #f6f4fc;
    flex-shrink: 0;
  }

  .pv-cart-drawer__item-img img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  .pv-cart-drawer__item-info {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
  }

  .pv-cart-drawer__item-title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #1e1b3a;
    text-decoration: none;
  }

  .pv-cart-drawer__item-price {
    font-size: 1.3rem;
    font-weight: 700;
    color: #4c46c4;
  }

  .pv-cart-drawer__item-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }

  .pv-cart-drawer__item-qty {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    border: 1px solid #ded9f7;
    border-radius: 2.4rem;
    padding: 0.3rem 0.5rem;
  }

  .pv-cart-drawer__item-qty span {
    font-size: 1.3rem;
    font-weight: 700;
    min-width: 1.4rem;
    text-align: center;
  }

  .pv-cart-drawer__qty-btn {
    width: 2.2rem;
    height: 2.2rem;
    border-radius: 50%;
    border: none;
    background: #f0eefa;
    color: #4c46c4;
    font-weight: 700;
    line-height: 1;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pv-cart-drawer__qty-btn:hover {
    background: #4c46c4;
    color: #ffffff;
  }

  .pv-cart-drawer__item-remove {
    background: none;
    border: none;
    color: #9d99b3;
    font-size: 1.2rem;
    cursor: pointer;
    text-decoration: underline;
    padding: 0;
    flex-shrink: 0;
  }

  .pv-cart-drawer__footer {
    border-top: 1px solid #f0eefa;
    padding: 1.6rem 2rem 2rem;
  }

  .pv-cart-drawer__subtotal {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.6rem;
    font-weight: 800;
    margin-bottom: 1.4rem;
  }

  .pv-cart-drawer__checkout {
    display: block;
    width: 100%;
    text-align: center;
    background: #4c46c4;
    color: #ffffff;
    border: none;
    border-radius: 3rem;
    padding: 1.3rem;
    font-size: 1.5rem;
    font-weight: 700;
    cursor: pointer;
    text-decoration: none;
  }

  .pv-cart-drawer__checkout:hover {
    background: #3a35a0;
  }

  body.pv-cart-drawer-open {
    overflow: hidden;
  }
{%- endstyle -%}

<!-- STICKY HEADER WRAPPER -->
<div class="pet-header-sticky-wrapper">
  <header class="pet-main-header">
    <div class="pet-main-header__container">
      <div class="pet-main-header__left">
        <button type="button" class="pet-mobile-toggle" aria-label="{{ 'custom.header.aria_toggle_mobile_menu' | t }}" aria-expanded="false" aria-controls="PetMainHeaderNav" data-mobile-toggle>
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>

        <!-- Logo -->
        <div class="pet-main-header__brand">
          <a href="{{ routes.root_url }}" class="pet-main-header__logo">
            <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" class="pet-logo-img">
          </a>
        </div>

        <!-- Left Navigation -->
        <nav class="pet-main-header__nav" id="PetMainHeaderNav">
          <div class="pet-nav-item">
            <a href="/pages/about-us" class="pet-nav-link{% if request.path contains '/about' %} is-active{% endif %}">{{ 'custom.header.nav_about_us' | t }}</a>
          </div>
          <div class="pet-nav-item">
            <a href="/collections/all" class="pet-nav-link{% if request.path contains '/collections' %} is-active{% endif %}">{{ 'custom.header.nav_all_products' | t }}</a>
          </div>
          <div class="pet-nav-item">
            <a href="/pages/contact" class="pet-nav-link{% if request.path contains '/contact' %} is-active{% endif %}">{{ 'custom.header.nav_contact' | t }}</a>
          </div>
        </nav>
      </div>

      <!-- Right Navigation & Actions -->
      <div class="pet-main-header__actions">
        <div class="pet-lang-switcher" data-lang-switcher>
          {%- form 'localization', id: 'HeaderLanguageForm', class: 'pet-lang-form' -%}
            <button type="button" class="pet-lang-toggle" data-lang-toggle aria-expanded="false" aria-haspopup="listbox">
              <span data-lang-current>{{ localization.language.endonym_name | capitalize }}</span>
              <svg viewBox="0 0 24 24" width="10" height="10"><path fill="currentColor" d="M7 10l5 5 5-5z"/></svg>
            </button>
            <ul class="pet-lang-dropdown" data-lang-dropdown hidden>
              {%- for language in localization.available_languages -%}
                <li>
                  <a
                    href="#"
                    data-value="{{ language.iso_code }}"
                    class="pet-lang-option{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}"
                  >{{ language.endonym_name | capitalize }}</a>
                </li>
              {%- endfor -%}
            </ul>
            <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}" data-lang-input>
          {%- endform -%}
        </div>

        <!-- Cart Icon -->
        <a href="{{ routes.cart_url }}" id="petCartLink" class="pet-action-icon-btn" aria-label="{{ 'custom.header.aria_cart' | t }}" aria-haspopup="dialog">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          <span id="petCartCount" class="pet-cart-count">{{ cart.item_count | default: 0 }}</span>
        </a>

        <!-- Search Button -->
        <a href="{{ routes.search_url }}" class="pet-search-btn" aria-label="{{ 'custom.header.aria_search' | t }}">
          <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.5">
            <circle cx="11" cy="11" r="8"/>
            <path d="m21 21-4.35-4.35"/>
          </svg>
          Search
        </a>
      </div>
    </div>
  </header>
</div>

<!-- CART DRAWER -->
<div id="pvCartDrawerOverlay" class="pv-cart-drawer-overlay"></div>
<aside id="pvCartDrawer" class="pv-cart-drawer" aria-label="{{ 'custom.header.aria_cart' | t }}">
  <div class="pv-cart-drawer__header">
    <h2 class="pv-cart-drawer__title">{{ 'custom.header.cart_title' | t }}</h2>
    <button type="button" id="pvCartDrawerClose" class="pv-cart-drawer__close" aria-label="{{ 'custom.header.aria_close' | t }}">
      <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><line x1="18" y1="6" x2="6" y2="18"/><line x1="6" y1="6" x2="18" y2="18"/></svg>
    </button>
  </div>
  <div id="pvCartDrawerBody" class="pv-cart-drawer__body">
    <p class="pv-cart-drawer__empty">{{ 'custom.header.cart_empty' | t }}</p>
  </div>
  <div id="pvCartDrawerFooter" class="pv-cart-drawer__footer" style="display: none;">
    <div class="pv-cart-drawer__subtotal">
      <span>{{ 'custom.header.cart_subtotal' | t }}</span>
      <span id="pvCartDrawerSubtotal">-</span>
    </div>
    <a href="{{ routes.cart_url }}" class="pv-cart-drawer__checkout">{{ 'custom.header.cart_checkout' | t }}</a>
  </div>
</aside>

<script>
  document.addEventListener('DOMContentLoaded', function () {
    // Mobile nav toggle
    var mobileToggle = document.querySelector('[data-mobile-toggle]');
    var mobileNav = document.getElementById('PetMainHeaderNav');
    if (mobileToggle && mobileNav) {
      mobileToggle.addEventListener('click', function () {
        var isOpen = mobileNav.classList.toggle('is-open');
        mobileToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });

      document.addEventListener('click', function (event) {
        if (!mobileNav.contains(event.target) && !mobileToggle.contains(event.target)) {
          mobileNav.classList.remove('is-open');
          mobileToggle.setAttribute('aria-expanded', 'false');
        }
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth > 989) {
          mobileNav.classList.remove('is-open');
          mobileToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Language switcher
    var langSwitcher = document.querySelector('[data-lang-switcher]');
    if (langSwitcher) {
      var langToggle = langSwitcher.querySelector('[data-lang-toggle]');
      var langDropdown = langSwitcher.querySelector('[data-lang-dropdown]');
      var langInput = langSwitcher.querySelector('[data-lang-input]');
      var langForm = langSwitcher.querySelector('form');

      langToggle.addEventListener('click', function (event) {
        event.stopPropagation();
        var isHidden = langDropdown.hasAttribute('hidden');
        if (isHidden) {
          langDropdown.removeAttribute('hidden');
          langToggle.setAttribute('aria-expanded', 'true');
        } else {
          langDropdown.setAttribute('hidden', '');
          langToggle.setAttribute('aria-expanded', 'false');
        }
      });

      langSwitcher.querySelectorAll('[data-value]').forEach(function (option) {
        option.addEventListener('click', function (event) {
          event.preventDefault();
          langInput.value = option.getAttribute('data-value');
          document.cookie = 'pet_vona_lang_set=1; path=/; max-age=31536000';
          if (langForm) langForm.submit();
        });
      });

      document.addEventListener('click', function (event) {
        if (!langSwitcher.contains(event.target)) {
          langDropdown.setAttribute('hidden', '');
          langToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Cart drawer
    var pvCartLink = document.getElementById('petCartLink');
    var pvCartDrawer = document.getElementById('pvCartDrawer');
    var pvCartDrawerOverlay = document.getElementById('pvCartDrawerOverlay');
    var pvCartDrawerClose = document.getElementById('pvCartDrawerClose');
    var pvCartDrawerBody = document.getElementById('pvCartDrawerBody');
    var pvCartDrawerFooter = document.getElementById('pvCartDrawerFooter');
    var pvCartDrawerSubtotal = document.getElementById('pvCartDrawerSubtotal');

    function pvFormatMoney(cents, currency) {
      try {
        return new Intl.NumberFormat(document.documentElement.lang || 'en', {
          style: 'currency',
          currency: currency
        }).format(cents / 100);
      } catch (e) {
        return (cents / 100).toFixed(2) + ' ' + currency;
      }
    }

    function pvEscapeHtml(str) {
      var div = document.createElement('div');
      div.textContent = str || '';
      return div.innerHTML;
    }

    function pvSetHeaderCartCount(count) {
      var countEl = document.getElementById('petCartCount');
      if (countEl) countEl.textContent = count;
    }

    function pvRenderCartDrawer() {
      if (!pvCartDrawerBody) return;
      fetch('/cart.js')
        .then(function (res) { return res.json(); })
        .then(function (cart) {
          pvSetHeaderCartCount(cart.item_count);

          if (!cart.items.length) {
            pvCartDrawerBody.innerHTML = '<p class="pv-cart-drawer__empty">{{ "custom.header.cart_empty" | t }}</p>';
            if (pvCartDrawerFooter) pvCartDrawerFooter.style.display = 'none';
            return;
          }

          if (pvCartDrawerFooter) pvCartDrawerFooter.style.display = '';

          pvCartDrawerBody.innerHTML = cart.items.map(function (item) {
            var img = item.image ? item.image.replace(/(\.[a-zA-Z]+)(\?|$)/, '_150x150$1$2') : '';
            return (
              '<div class="pv-cart-drawer__item" data-pv-cart-line="' + item.key + '">' +
                '<div class="pv-cart-drawer__item-img"><img src="' + img + '" alt="" loading="lazy"></div>' +
                '<div class="pv-cart-drawer__item-info">' +
                  '<a class="pv-cart-drawer__item-title" href="' + item.url + '">' + pvEscapeHtml(item.product_title) + '</a>' +
                  '<span class="pv-cart-drawer__item-price">' + pvFormatMoney(item.final_line_price, cart.currency) + '</span>' +
                  '<div class="pv-cart-drawer__item-row">' +
                    '<div class="pv-cart-drawer__item-qty">' +
                      '<button type="button" class="pv-cart-drawer__qty-btn" data-pv-cart-minus aria-label="{{ "custom.pv_home.decrease_qty" | t }}">−</button>' +
                      '<span>' + item.quantity + '</span>' +
                      '<button type="button" class="pv-cart-drawer__qty-btn" data-pv-cart-plus aria-label="{{ "custom.pv_home.increase_qty" | t }}">+</button>' +
                    '</div>' +
                    '<button type="button" class="pv-cart-drawer__item-remove" data-pv-cart-remove>{{ "custom.header.aria_close" | t }}</button>' +
                  '</div>' +
                '</div>' +
              '</div>'
            );
          }).join('');

          if (pvCartDrawerSubtotal) pvCartDrawerSubtotal.textContent = pvFormatMoney(cart.total_price, cart.currency);
        })
        .catch(function () {
          pvCartDrawerBody.innerHTML = '<p class="pv-cart-drawer__empty">{{ "custom.header.cart_empty" | t }}</p>';
        });
    }

    function pvOpenCartDrawer() {
      if (!pvCartDrawer) return;
      pvCartDrawer.classList.add('is-active');
      if (pvCartDrawerOverlay) pvCartDrawerOverlay.classList.add('is-active');
      document.body.classList.add('pv-cart-drawer-open');
      pvRenderCartDrawer();
    }

    function pvCloseCartDrawer() {
      if (!pvCartDrawer) return;
      pvCartDrawer.classList.remove('is-active');
      if (pvCartDrawerOverlay) pvCartDrawerOverlay.classList.remove('is-active');
      document.body.classList.remove('pv-cart-drawer-open');
    }

    window.pvOpenCartDrawer = pvOpenCartDrawer;

    if (pvCartLink) {
      pvCartLink.addEventListener('click', function (event) {
        event.preventDefault();
        pvOpenCartDrawer();
      });
    }
    if (pvCartDrawerClose) pvCartDrawerClose.addEventListener('click', pvCloseCartDrawer);
    if (pvCartDrawerOverlay) pvCartDrawerOverlay.addEventListener('click', pvCloseCartDrawer);

    document.addEventListener('keyup', function (event) {
      if (event.key === 'Escape') pvCloseCartDrawer();
    });

    if (pvCartDrawerBody) {
      pvCartDrawerBody.addEventListener('click', function (event) {
        var lineEl = event.target.closest('[data-pv-cart-line]');
        if (!lineEl) return;

        var minus = event.target.closest('[data-pv-cart-minus]');
        var plus = event.target.closest('[data-pv-cart-plus]');
        var remove = event.target.closest('[data-pv-cart-remove]');
        if (!minus && !plus && !remove) return;

        event.preventDefault();
        var key = lineEl.getAttribute('data-pv-cart-line');
        var qtySpan = lineEl.querySelector('.pv-cart-drawer__item-qty span');
        var currentQty = parseInt(qtySpan.textContent, 10) || 0;
        var newQty = remove ? 0 : currentQty + (plus ? 1 : -1);
        if (newQty < 0) newQty = 0;

        fetch('/cart/change.js', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ id: key, quantity: newQty })
        })
          .then(function (res) { return res.json(); })
          .then(function () { pvRenderCartDrawer(); })
          .catch(function () {});
      });
    }
  });
</script>

