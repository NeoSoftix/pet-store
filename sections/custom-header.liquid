{%- style -%}
  #shopify-section-{{ section.id }} {
    position: sticky;
    top: 0;
    z-index: 1000;
  }

  .pet-header-sticky-wrapper {
    position: relative;
    z-index: 1;
  }

  .pet-main-header {
    background-color: {{ section.settings.header_bg | default: '#ffffff' }};
    border-bottom: 1px solid {{ section.settings.border_color | default: '#f0f0f4' }};
    position: relative;
    z-index: 1001;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  .pet-main-header__container {
    max-width: {{ section.settings.container_width | default: 1400 }}px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.6rem 2.4rem;
    gap: 2rem;
    position: relative;
  }

  .pet-main-header__left {
    display: flex;
    align-items: center;
    gap: 4rem;
    min-width: 0;
  }

  .pet-main-header__nav {
    display: flex;
    align-items: center;
    gap: 2.8rem;
  }

  .pet-nav-item {
    position: relative;
  }

  .pet-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: {{ section.settings.nav_color | default: '#111827' }};
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 600;
    padding: 0.8rem 0;
    transition: color 0.15s ease;
    cursor: pointer;
    background: none;
    border: none;
  }

  .pet-nav-link:hover,
  .pet-nav-link.is-active {
    color: #4c46c4;
  }

  .pet-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: #ffffff;
    border: 1px solid #f0f0f4;
    border-radius: 1.2rem;
    padding: 1.2rem 0;
    min-width: 200px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1050;
  }

  .pet-nav-item:hover .pet-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .pet-dropdown-menu a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.8rem;
    color: #374151;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 500;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .pet-dropdown-menu a:hover {
    background: #f3f1fd;
    color: #4c46c4;
  }

  .pet-main-header__brand {
    display: flex;
    align-items: center;
  }

  .pet-main-header__logo {
    text-decoration: none;
    display: flex;
    align-items: center;
  }

  .pet-logo-img {
    height: 3.6rem;
    width: auto;
    display: block;
    max-width: 100%;
  }

  .pet-main-header__actions {
    display: flex;
    align-items: center;
    gap: 2rem;
    flex-shrink: 0;
  }

  .pet-lang-switcher {
    position: relative;
  }

  .pet-lang-toggle {
    display: flex;
    align-items: center;
    gap: 0.3rem;
    background: none;
    border: none;
    cursor: pointer;
    font-size: 1.25rem;
    font-weight: 600;
    color: #6b7280;
    padding: 0;
  }

  .pet-lang-toggle:hover {
    color: #4c46c4;
  }

  .pet-lang-dropdown {
    position: absolute;
    top: 100%;
    right: 0;
    margin-top: 0.8rem;
    background: #ffffff;
    border-radius: 0.8rem;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.14);
    list-style: none;
    padding: 0.6rem 0;
    min-width: 140px;
    z-index: 1100;
  }

  .pet-lang-dropdown a {
    display: block;
    padding: 0.6rem 1.4rem;
    color: #374151;
    font-size: 1.3rem;
    font-weight: 500;
    text-decoration: none;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .pet-lang-dropdown a:hover,
  .pet-lang-dropdown a.is-active {
    background: #f3f1fd;
    color: #4c46c4;
  }

  .pet-action-icon-btn {
    background: none;
    border: none;
    color: #111827;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem;
    border-radius: 50%;
    transition: background-color 0.15s ease, color 0.15s ease;
    text-decoration: none;
    position: relative;
  }

  .pet-action-icon-btn:hover {
    background-color: #f3f4f6;
    color: #4c46c4;
  }

  .pet-cart-count {
    position: absolute;
    top: -0.2rem;
    right: -0.2rem;
    background-color: #4c46c4;
    color: #ffffff;
    font-size: 1rem;
    font-weight: 700;
    width: 1.8rem;
    height: 1.8rem;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pet-mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: #111827;
    cursor: pointer;
    padding: 1rem;
    align-items: center;
    justify-content: center;
    min-width: 4.4rem;
    min-height: 4.4rem;
    border-radius: 0.6rem;
  }

  .pet-mobile-toggle:hover {
    background-color: #f3f4f6;
  }

  /* TABLET & MOBILE (<=989px): hide inline nav, show hamburger toggle */
  @media screen and (max-width: 989px) {
    .pet-main-header__nav {
      display: none;
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      background-color: {{ section.settings.header_bg | default: '#ffffff' }};
      border-bottom: 1px solid {{ section.settings.border_color | default: '#f0f0f4' }};
      box-shadow: 0 16px 24px rgba(0, 0, 0, 0.08);
      padding: 0.8rem 2.4rem 1.6rem;
      z-index: 1002;
    }

    .pet-main-header__nav.is-open {
      display: flex;
    }

    .pet-nav-item {
      width: 100%;
    }

    .pet-nav-link {
      width: 100%;
      padding: 1.2rem 0;
      font-size: 1.6rem;
      min-height: 4.4rem;
    }

    .pet-dropdown-menu {
      position: static;
      display: none;
      opacity: 1;
      visibility: visible;
      transform: none;
      box-shadow: none;
      border: none;
      border-radius: 0;
      padding: 0 0 0 1.6rem;
      min-width: 0;
      width: 100%;
    }

    .pet-nav-item:hover .pet-dropdown-menu {
      transform: none;
    }

    .pet-mobile-toggle {
      display: flex;
    }
  }

  /* TABLET (750px-989px) */
  @media screen and (min-width: 750px) and (max-width: 989px) {
    .pet-main-header__container {
      padding: 1.6rem 3.2rem;
    }
  }

  /* MOBILE (<=749px) */
  @media screen and (max-width: 749px) {
    .pet-main-header__container {
      padding: 1.2rem 1.6rem;
      gap: 1.2rem;
    }

    .pet-main-header__left {
      gap: 1.2rem;
    }

    .pet-logo-img {
      height: 2.8rem;
    }

    .pet-main-header__actions {
      gap: 0.8rem;
    }

    .pet-lang-toggle span {
      max-width: 6rem;
      overflow: hidden;
      text-overflow: ellipsis;
      white-space: nowrap;
    }

    .pet-action-icon-btn {
      padding: 1rem;
      min-width: 4.2rem;
      min-height: 4.2rem;
    }
  }

  /* SMALL PHONES (<=480px) */
  @media screen and (max-width: 480px) {
    .pet-main-header__container {
      padding: 1rem 1.2rem;
      gap: 0.8rem;
    }

    .pet-main-header__left {
      gap: 0.8rem;
    }

    .pet-logo-img {
      height: 2.4rem;
    }

    .pet-main-header__actions {
      gap: 0.4rem;
    }

    .pet-mobile-toggle {
      min-width: 4rem;
      min-height: 4rem;
      padding: 0.8rem;
    }

    .pet-lang-toggle {
      font-size: 1.15rem;
    }

    .pet-lang-toggle span {
      max-width: 4.4rem;
    }

    .pet-lang-dropdown {
      right: -1rem;
      min-width: 120px;
    }

    .pet-cart-count {
      width: 1.6rem;
      height: 1.6rem;
      font-size: 0.9rem;
    }
  }
{%- endstyle -%}

<!-- STICKY HEADER WRAPPER -->
<div class="pet-header-sticky-wrapper">
  <header class="pet-main-header">
    <div class="pet-main-header__container">
      <div class="pet-main-header__left">
        <button type="button" class="pet-mobile-toggle" aria-label="{{ 'custom.header.aria_toggle_mobile_menu' | t }}" aria-expanded="false" aria-controls="PetMainHeaderNav" data-mobile-toggle>
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2">
            <line x1="3" y1="6" x2="21" y2="6"/>
            <line x1="3" y1="12" x2="21" y2="12"/>
            <line x1="3" y1="18" x2="21" y2="18"/>
          </svg>
        </button>

        <!-- Logo -->
        <div class="pet-main-header__brand">
          <a href="{{ routes.root_url }}" class="pet-main-header__logo">
            <img src="{{ 'logo.png' | asset_url }}" alt="{{ shop.name }}" class="pet-logo-img">
          </a>
        </div>

        <!-- Left Navigation -->
        <nav class="pet-main-header__nav" id="PetMainHeaderNav">
          <div class="pet-nav-item">
            <a href="/pages/about-us" class="pet-nav-link{% if request.path contains '/about' %} is-active{% endif %}">{{ 'custom.header.nav_about_us' | t }}</a>
          </div>
          <div class="pet-nav-item">
            <a href="/collections/all" class="pet-nav-link{% if request.path contains '/collections' %} is-active{% endif %}">{{ 'custom.header.nav_all_products' | t }}</a>
          </div>
          <div class="pet-nav-item">
            <a href="/pages/contact" class="pet-nav-link{% if request.path contains '/contact' %} is-active{% endif %}">{{ 'custom.header.nav_contact' | t }}</a>
          </div>
        </nav>
      </div>

      <!-- Right Navigation & Actions -->
      <div class="pet-main-header__actions">
        <div class="pet-lang-switcher" data-lang-switcher>
          {%- form 'localization', id: 'HeaderLanguageForm', class: 'pet-lang-form' -%}
            <button type="button" class="pet-lang-toggle" data-lang-toggle aria-expanded="false" aria-haspopup="listbox">
              <span data-lang-current>{{ localization.language.endonym_name | capitalize }}</span>
              <svg viewBox="0 0 24 24" width="10" height="10"><path fill="currentColor" d="M7 10l5 5 5-5z"/></svg>
            </button>
            <ul class="pet-lang-dropdown" data-lang-dropdown hidden>
              {%- for language in localization.available_languages -%}
                <li>
                  <a
                    href="#"
                    data-value="{{ language.iso_code }}"
                    class="pet-lang-option{% if language.iso_code == localization.language.iso_code %} is-active{% endif %}"
                  >{{ language.endonym_name | capitalize }}</a>
                </li>
              {%- endfor -%}
            </ul>
            <input type="hidden" name="locale_code" value="{{ localization.language.iso_code }}" data-lang-input>
          {%- endform -%}
        </div>

        <!-- Cart Icon -->
        <a href="{{ routes.cart_url }}" id="petCartLink" class="pet-action-icon-btn" aria-label="{{ 'custom.header.aria_cart' | t }}">
          <svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M6 2L3 6v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6l-3-4z"/>
            <line x1="3" y1="6" x2="21" y2="6"/>
            <path d="M16 10a4 4 0 0 1-8 0"/>
          </svg>
          {%- if cart.item_count > 0 -%}
            <span id="petCartCount" class="pet-cart-count">{{ cart.item_count }}</span>
          {%- endif -%}
        </a>
      </div>
    </div>
  </header>
</div>

{% javascript %}
  document.addEventListener('DOMContentLoaded', function () {
    // Mobile nav toggle
    var mobileToggle = document.querySelector('[data-mobile-toggle]');
    var mobileNav = document.getElementById('PetMainHeaderNav');
    if (mobileToggle && mobileNav) {
      mobileToggle.addEventListener('click', function () {
        var isOpen = mobileNav.classList.toggle('is-open');
        mobileToggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });

      document.addEventListener('click', function (event) {
        if (!mobileNav.contains(event.target) && !mobileToggle.contains(event.target)) {
          mobileNav.classList.remove('is-open');
          mobileToggle.setAttribute('aria-expanded', 'false');
        }
      });

      window.addEventListener('resize', function () {
        if (window.innerWidth > 989) {
          mobileNav.classList.remove('is-open');
          mobileToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }

    // Language switcher
    var langSwitcher = document.querySelector('[data-lang-switcher]');
    if (langSwitcher) {
      var langToggle = langSwitcher.querySelector('[data-lang-toggle]');
      var langDropdown = langSwitcher.querySelector('[data-lang-dropdown]');
      var langInput = langSwitcher.querySelector('[data-lang-input]');
      var langForm = langSwitcher.querySelector('form');

      langToggle.addEventListener('click', function (event) {
        event.stopPropagation();
        var isHidden = langDropdown.hasAttribute('hidden');
        if (isHidden) {
          langDropdown.removeAttribute('hidden');
          langToggle.setAttribute('aria-expanded', 'true');
        } else {
          langDropdown.setAttribute('hidden', '');
          langToggle.setAttribute('aria-expanded', 'false');
        }
      });

      langSwitcher.querySelectorAll('[data-value]').forEach(function (option) {
        option.addEventListener('click', function (event) {
          event.preventDefault();
          langInput.value = option.getAttribute('data-value');
          document.cookie = 'pet_vona_lang_set=1; path=/; max-age=31536000';
          if (langForm) langForm.submit();
        });
      });

      document.addEventListener('click', function (event) {
        if (!langSwitcher.contains(event.target)) {
          langDropdown.setAttribute('hidden', '');
          langToggle.setAttribute('aria-expanded', 'false');
        }
      });
    }
  });
{% endjavascript %}

{% schema %}
{
  "name": "Custom header",
  "settings": [
    {
      "type": "color",
      "id": "header_bg",
      "label": "Header background",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "nav_color",
      "label": "Navigation text color",
      "default": "#111827"
    },
    {
      "type": "color",
      "id": "border_color",
      "label": "Border color",
      "default": "#f0f0f4"
    },
    {
      "type": "range",
      "id": "container_width",
      "min": 1000,
      "max": 1600,
      "step": 20,
      "unit": "px",
      "label": "Container max width",
      "default": 1400
    }
  ],
  "presets": [
    {
      "name": "Custom header"
    }
  ]
}
{% endschema %}
