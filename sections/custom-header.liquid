{%- style -%}
  /* Sticky Header Wrapper */
  .pet-header-sticky-wrapper {
    position: sticky;
    top: 0;
    z-index: 1000;
    box-shadow: 0 4px 20px rgba(0, 0, 0, 0.05);
  }

  /* Top Announcement Bar */
  .pet-announcement-bar {
    background-color: {{ section.settings.announcement_bg | default: '#4c46c4' }};
    color: {{ section.settings.announcement_text_color | default: '#ffffff' }};
    font-size: 1.3rem;
    font-weight: 500;
    padding: 0.7rem 2.4rem;
    position: relative;
    z-index: 1002;
  }

  .pet-announcement-bar__inner {
    max-width: {{ section.settings.container_width | default: 1400 }}px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }

  .pet-announcement-bar__center {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin: 0 auto;
  }

  .pet-announcement-bar__arrow {
    background: none;
    border: none;
    color: currentColor;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.2rem;
    opacity: 0.85;
    transition: opacity 0.2s ease;
  }

  .pet-announcement-bar__arrow:hover {
    opacity: 1;
  }

  .pet-announcement-bar__content {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    white-space: nowrap;
  }

  .pet-announcement-bar__right {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .pet-announcement-bar__socials {
    display: flex;
    align-items: center;
    gap: 1.2rem;
  }

  .pet-announcement-bar__socials a {
    color: currentColor;
    display: flex;
    align-items: center;
    justify-content: center;
    opacity: 0.9;
    text-decoration: none;
    transition: opacity 0.2s ease;
  }

  .pet-announcement-bar__socials a:hover {
    opacity: 1;
  }

  .pet-announcement-bar__divider {
    width: 1px;
    height: 1.4rem;
    background-color: rgba(255, 255, 255, 0.35);
  }

  .pet-announcement-bar__select {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    cursor: pointer;
    font-size: 1.25rem;
    opacity: 0.95;
  }

  /* Main Header Styling */
  .pet-main-header {
    background-color: {{ section.settings.header_bg | default: '#ffffff' }};
    border-bottom: 1px solid {{ section.settings.border_color | default: '#f0f0f4' }};
    position: relative;
    z-index: 1001;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
  }

  .pet-main-header__container {
    max-width: {{ section.settings.container_width | default: 1400 }}px;
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 1.2rem 2.4rem;
    gap: 2rem;
  }

  /* Brand / Logo & Collections Badge */
  .pet-main-header__brand {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-shrink: 0;
  }

  .pet-main-header__logo {
    text-decoration: none;
    color: {{ section.settings.logo_color | default: '#111827' }};
    font-size: 2.8rem;
    font-weight: 900;
    letter-spacing: -0.04em;
    display: flex;
    align-items: center;
  }

  .pet-logo-text {
    display: inline-flex;
    align-items: center;
  }

  .pet-logo-bone {
    font-size: 2rem;
    margin: 0 1px;
    display: inline-block;
    transform: rotate(-15deg);
  }

  /* Collections Dropdown Link */
  .pet-collections-wrapper {
    position: relative;
  }

  .pet-main-header__collections-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.4rem 1.6rem;
    color: #4b5563;
    font-size: 1.3rem;
    font-weight: 500;
    text-decoration: none;
    border-radius: 3rem;
    border: 1px solid #d1d5db;
    cursor: pointer;
    background: transparent;
    transition: all 0.2s ease;
  }

  .pet-main-header__collections-badge:hover,
  .pet-collections-wrapper:hover .pet-main-header__collections-badge {
    border-color: #4c46c4;
    color: #4c46c4;
  }

  /* Navigation Bar */
  .pet-main-header__nav {
    display: flex;
    align-items: center;
  }

  .pet-nav-list {
    display: flex;
    align-items: center;
    gap: 2.8rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pet-nav-item {
    position: relative;
  }

  .pet-nav-link-wrapper {
    position: relative;
    display: inline-flex;
    flex-direction: column;
    align-items: flex-start;
  }

  .pet-nav-badge {
    background-color: #e53935;
    color: #ffffff;
    font-size: 0.85rem;
    font-weight: 800;
    padding: 0.1rem 0.5rem;
    border-radius: 0.4rem;
    line-height: 1;
    position: absolute;
    top: -1.1rem;
    left: 0.6rem;
    letter-spacing: 0.05em;
    box-shadow: 0 2px 4px rgba(229, 57, 53, 0.25);
  }

  .pet-nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: {{ section.settings.nav_color | default: '#111827' }};
    text-decoration: none;
    font-size: 1.5rem;
    font-weight: 600;
    padding: 0.8rem 0;
    transition: color 0.15s ease;
    cursor: pointer;
  }

  .pet-nav-link:hover {
    color: #4c46c4;
  }

  .pet-nav-link--purple {
    color: #4c46c4;
    font-weight: 700;
  }

  /* DROPDOWNS & SUBMENUS FOR ALL NAV ITEMS */
  .pet-dropdown-menu {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(8px);
    background: #ffffff;
    border: 1px solid #f0f0f4;
    border-radius: 1.2rem;
    padding: 1.2rem 0;
    min-width: 220px;
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.12);
    opacity: 0;
    visibility: hidden;
    transition: all 0.2s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 1050;
  }

  .pet-nav-item:hover .pet-dropdown-menu,
  .pet-collections-wrapper:hover .pet-dropdown-menu {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .pet-dropdown-menu a {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.8rem;
    color: #374151;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 500;
    transition: background 0.15s ease, color 0.15s ease;
  }

  .pet-dropdown-menu a:hover {
    background: #f3f1fd;
    color: #4c46c4;
    font-weight: 600;
  }

  /* OVERLAY BACKDROP FOR MEGA MENU OVER HERO SECTION */
  .pet-megamenu-backdrop {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    bottom: 0;
    background: rgba(17, 24, 39, 0.35);
    backdrop-filter: blur(2px);
    z-index: 999;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.25s ease, visibility 0.25s ease;
    pointer-events: none;
  }

  .pet-header-sticky-wrapper:has(.pet-megamenu:hover) ~ .pet-megamenu-backdrop,
  body.has-megamenu-open .pet-megamenu-backdrop {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;
  }

  /* MEGA MENU DROPDOWN OVERLAY ON HERO SECTION */
  .pet-nav-item--has-megamenu {
    position: static;
  }

  .pet-megamenu {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    width: 100%;
    background-color: #ffffff;
    border-top: 1px solid #f0f0f4;
    box-shadow: 0 24px 48px rgba(0, 0, 0, 0.14);
    opacity: 0;
    visibility: hidden;
    transform: translateY(8px);
    transition: opacity 0.25s cubic-bezier(0.16, 1, 0.3, 1), transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.25s;
    pointer-events: none;
    z-index: 1010;
  }

  .pet-nav-item--has-megamenu:hover .pet-megamenu,
  .pet-megamenu.is-open {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
    pointer-events: auto;
  }

  .pet-megamenu__inner {
    max-width: {{ section.settings.container_width | default: 1400 }}px;
    margin: 0 auto;
    display: flex;
    min-height: 460px;
  }

  /* Sidebar Tabs */
  .pet-megamenu__sidebar {
    width: 240px;
    flex-shrink: 0;
    border-right: 1px solid #f0f0f4;
    padding: 2.4rem 1.6rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    background-color: #ffffff;
  }

  .pet-megamenu__tab {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    padding: 1.2rem 1.6rem;
    border: none;
    background: transparent;
    border-radius: 1rem;
    font-size: 1.5rem;
    font-weight: 500;
    color: #374151;
    cursor: pointer;
    text-align: left;
    transition: all 0.15s ease;
  }

  .pet-megamenu__tab:hover {
    background-color: #f9fafb;
    color: #111827;
  }

  .pet-megamenu__tab.active {
    background-color: #f3f1fd;
    color: #111827;
    font-weight: 700;
  }

  .pet-megamenu__tab svg {
    color: #9ca3af;
    transition: transform 0.2s ease;
  }

  .pet-megamenu__tab.active svg {
    color: #111827;
    transform: translateX(2px);
  }

  /* Right Content Panels */
  .pet-megamenu__content {
    flex-grow: 1;
    padding: 2.8rem 3.2rem;
    background-color: #ffffff;
  }

  .pet-megamenu__panel {
    display: none;
  }

  .pet-megamenu__panel.active {
    display: block;
    animation: petFadeIn 0.25s ease-out forwards;
  }

  @keyframes petFadeIn {
    from { opacity: 0; transform: translateY(4px); }
    to { opacity: 1; transform: translateY(0); }
  }

  /* Mega Menu Grid */
  .pet-megamenu__grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 3.2rem 2.8rem;
  }

  .pet-megamenu__col {
    display: flex;
    flex-direction: column;
  }

  .pet-megamenu__title {
    font-size: 1.6rem;
    font-weight: 800;
    color: #111827;
    margin: 0 0 1.2rem 0;
    letter-spacing: -0.01em;
  }

  .pet-megamenu__image-card {
    width: 100%;
    height: 145px;
    border-radius: 1.2rem;
    overflow: hidden;
    margin-bottom: 1.4rem;
    background-color: #f3f4f6;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .pet-megamenu__image-card img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    transition: transform 0.3s ease;
  }

  .pet-megamenu__image-card:hover img {
    transform: scale(1.04);
  }

  .pet-megamenu__links {
    list-style: none;
    padding: 0;
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .pet-megamenu__links a {
    color: #4b5563;
    text-decoration: none;
    font-size: 1.4rem;
    font-weight: 500;
    transition: color 0.15s ease;
  }

  .pet-megamenu__links a:hover {
    color: #4c46c4;
  }

  /* Image 5 Subnav Product Cards Grid */
  .pet-subnav-filters {
    display: flex;
    align-items: center;
    gap: 1.2rem;
    margin-bottom: 2rem;
    border-bottom: 1px solid #f0f0f4;
    padding-bottom: 1.2rem;
  }

  .pet-subnav-filter-btn {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding: 0.8rem 1.6rem;
    border-radius: 0.8rem;
    border: 1px solid #e5e7eb;
    background: #ffffff;
    font-size: 1.35rem;
    font-weight: 600;
    color: #374151;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pet-subnav-filter-btn.active {
    background: #f3f1fd;
    border-color: #4c46c4;
    color: #4c46c4;
  }

  .pet-product-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .pet-product-card {
    background: #ffffff;
    border-radius: 1.2rem;
    padding: 1.2rem;
    box-shadow: 0 2px 8px rgba(0,0,0,0.04);
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .pet-product-card__title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #111827;
    margin: 0;
  }

  .pet-product-card__img {
    width: 100%;
    height: 120px;
    object-fit: contain;
    background: #f9fafb;
    border-radius: 0.8rem;
  }

  /* Header Right Actions */
  .pet-main-header__actions {
    display: flex;
    align-items: center;
    gap: 1.4rem;
    flex-shrink: 0;
  }

  .pet-location-pill {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    background-color: #ffffff;
    border: 1px solid #e5e7eb;
    border-radius: 3rem;
    padding: 0.6rem 1.4rem;
    font-size: 1.4rem;
    font-weight: 600;
    color: #111827;
    cursor: pointer;
    transition: all 0.2s ease;
  }

  .pet-location-pill:hover {
    border-color: #4c46c4;
    color: #4c46c4;
  }

  .pet-action-icon-btn {
    background: none;
    border: none;
    color: #111827;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 0.6rem;
    border-radius: 50%;
    transition: background-color 0.15s ease, color 0.15s ease;
    text-decoration: none;
  }

  .pet-action-icon-btn:hover {
    background-color: #f3f4f6;
    color: #4c46c4;
  }

  .pet-action-theme-btn {
    width: 3.8rem;
    height: 3.8rem;
    border-radius: 50%;
    border: 1px solid #e5e7eb;
    background: transparent;
    display: flex;
    align-items: center;
    justify-content: center;
    cursor: pointer;
    color: #111827;
    transition: all 0.2s ease;
  }

  .pet-action-theme-btn:hover {
    border-color: #4c46c4;
    color: #4c46c4;
    background-color: #f8f7ff;
  }

  /* Responsive Mobile Menu Toggle */
  .pet-mobile-toggle {
    display: none;
    background: none;
    border: none;
    color: #111827;
    cursor: pointer;
    padding: 0.4rem;
  }

  @media screen and (max-width: 989px) {
    .pet-announcement-bar__socials,
    .pet-announcement-bar__select {
      display: none;
    }

    .pet-main-header__nav,
    .pet-location-pill {
      display: none;
    }

    .pet-mobile-toggle {
      display: block;
    }
  }
{%- endstyle -%}

