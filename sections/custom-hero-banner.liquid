      <div class="custom-hero__media-left">
        <img src="{{ 'thirdslideimage.png' | asset_url }}" alt="Everything your Best Friend needs" loading="eager">
      </div>

      <div class="custom-hero__content">
        <p class="custom-hero__label">EXCLUSIVE LIFESTYLE</p>
        <h1 class="custom-hero__heading">Everything your Best Friend needs</h1>
        <p class="custom-hero__subtext">Give your pet the pampering they deserve. Book now to secure exclusive savings before our slots fill up.</p>
        <div class="custom-hero__buttons">
          <a href="/pages/booking" class="custom-hero__btn custom-hero__btn--solid">Book now</a>
        </div>
      </div>
    </div>
  </div>

  <!-- Slide Indicators -->
  <div class="custom-hero__dots" data-hero-dots>
    <button class="custom-hero__dot" type="button" aria-current="true" data-hero-dot></button>
    <button class="custom-hero__dot" type="button" aria-current="false" data-hero-dot></button>
    <button class="custom-hero__dot" type="button" aria-current="false" data-hero-dot></button>
  </div>
</hero-slider>

