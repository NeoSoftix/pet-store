        </div>
      </div>
    </div>
  </div>

  <!-- SLIDE 2 -->
  <div class="custom-hero__slide custom-hero__slide--slide-2" data-hero-slide>
    <div class="custom-hero__inner">
      <div class="custom-hero__content">
        <p class="custom-hero__label">OUR BEST OFFERS.</p>
        <h1 class="custom-hero__heading">Healthy meals, Happier playtime</h1>
        <p class="custom-hero__subtext">Give your furry family members the wholesome, nutrient-rich meals they deserve.</p>
        <div class="custom-hero__buttons">
