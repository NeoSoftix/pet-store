{%- style -%}
  .pet-all-products-section {
    padding: 5rem 2rem;
    background-color: #f9fafb;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .pet-all-products-container {
    max-width: 1050px;
    margin: 0 auto;
  }

  .pet-all-products-header {
    text-align: center;
    margin-bottom: 2.8rem;
  }

  .pet-all-products-header h1 {
    font-size: 3.2rem;
    font-weight: 800;
    color: #111827;
    margin: 0 0 0.6rem 0;
    letter-spacing: -0.02em;
  }

  .pet-all-products-header p {
    font-size: 1.4rem;
    color: #6b7280;
    margin: 0;
  }

  .pet-all-products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .pet-product-card-full {
    background-color: #ffffff;
    border-radius: 1.4rem;
    border: 1px solid #e5e7eb;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
    padding: 1rem;
  }

  .pet-product-card-full:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
  }

  .pet-product-card-full__image-box {
    position: relative;
    width: 100%;
    height: 190px;
    background-color: #f9fafb;
    border-radius: 1rem;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid #f0f0f4;
  }

  .pet-product-card-full__image-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .pet-product-card-full:hover .pet-product-card-full__image-box img {
    transform: scale(1.05);
  }

  .pet-product-card-full__body {
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex-grow: 1;
  }

  .pet-product-card-full__title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #111827;
    line-height: 1.3;
    margin: 0;
    height: 3.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pet-product-card-full:hover .pet-product-card-full__title {
    color: #4c46c4;
  }

  .pet-product-card-full__rating {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.15rem;
    color: #6b7280;
  }

  .pet-product-card-full__stars {
    color: #ea580c;
    font-weight: 700;
  }

  .pet-card__badges {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
  }

  .pet-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    border-radius: 0.4rem;
    border: 1px solid #e5e7eb;
    background-color: #ffffff;
    font-size: 1.1rem;
    font-weight: 600;
    color: #4b5563;
  }

  .pet-product-card-full__price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.6rem;
  }

  .pet-product-card-full__price {
    font-size: 1.6rem;
    font-weight: 800;
    color: #4c46c4;
  }

  .pet-product-card-full__btn {
    padding: 0.6rem 1.4rem;
    background-color: #4c46c4;
    color: #ffffff;
    border: none;
    border-radius: 2rem;
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 3px 8px rgba(76, 70, 196, 0.25);
  }

  .pet-product-card-full__btn:hover {
    background-color: #3b35ad;
    box-shadow: 0 5px 14px rgba(76, 70, 196, 0.4);
  }

  @media screen and (max-width: 989px) {
    .pet-all-products-section {
      padding: 4rem 1.5rem;
    }

    .pet-all-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.6rem;
    }

    .pet-all-products-header h1 {
      font-size: 2.6rem;
    }
  }

  @media screen and (max-width: 749px) {
    .pet-all-products-section {
      padding: 3rem 1.2rem;
    }

    .pet-all-products-header {
      margin-bottom: 2rem;
    }

    .pet-all-products-header h1 {
      font-size: 2.2rem;
    }

    .pet-all-products-header p {
      font-size: 1.2rem;
    }

    .pet-all-products-grid {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.2rem;
    }

    .pet-product-card-full {
      padding: 0.8rem;
      border-radius: 1rem;
    }

    .pet-product-card-full__image-box {
      height: 140px;
      padding: 0.6rem;
    }

    .pet-product-card-full__title {
      font-size: 1.2rem;
      height: 3.1rem;
    }

    .pet-product-card-full__rating {
      font-size: 1rem;
    }

    .pet-badge {
      font-size: 0.95rem;
      padding: 0.2rem 0.5rem;
    }

    .pet-product-card-full__price {
      font-size: 1.3rem;
    }

    .pet-product-card-full__btn {
      padding: 0.6rem 1rem;
      font-size: 1.05rem;
      min-height: 2.75rem;
      display: inline-flex;
      align-items: center;
      justify-content: center;
    }
  }

  @media screen and (max-width: 480px) {
    .pet-all-products-grid {
      grid-template-columns: 1fr;
      gap: 1.4rem;
    }

    .pet-product-card-full__image-box {
      height: 190px;
    }

    .pet-product-card-full__price-row {
      flex-wrap: wrap;
      gap: 0.6rem;
    }

    .pet-product-card-full__btn {
      width: 100%;
    }
  }

  .pet-all-products-pagination {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.6rem;
    margin-top: 3rem;
    flex-wrap: wrap;
  }

  .pet-all-products-pagination__link,
  .pet-all-products-pagination__ellipsis {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 2.8rem;
    height: 2.8rem;
    padding: 0 0.6rem;
    border-radius: 0.6rem;
    font-size: 1.3rem;
    font-weight: 600;
    text-decoration: none;
    color: #374151;
  }

  .pet-all-products-pagination__link {
    border: 1px solid #e5e7eb;
    background-color: #ffffff;
    transition: all 0.2s ease;
  }

  .pet-all-products-pagination__link:hover {
    border-color: #4c46c4;
    color: #4c46c4;
  }

  .pet-all-products-pagination__link.is-active {
    background-color: #4c46c4;
    border-color: #4c46c4;
    color: #ffffff;
    cursor: default;
  }

  .pet-all-products-pagination__link.is-disabled {
    opacity: 0.4;
    pointer-events: none;
  }
{%- endstyle -%}

<section class="pet-all-products-section" id="pet-all-products-section">
  <div class="pet-all-products-container">
    <div class="pet-all-products-header">
      <h1>{{ 'custom.all_products.heading' | t }}</h1>
      <p>{{ 'custom.all_products.subheading' | t }}</p>
    </div>

    {%- paginate collections.all.products by 9 -%}
      <div class="pet-all-products-grid">
        {%- for product in collections.all.products -%}
          <a href="{{ product.url }}" class="pet-product-card-full">
            <div class="pet-product-card-full__image-box">
              {%- if product.featured_image -%}
                {{ product.featured_image | image_url: width: 500 | image_tag: alt: product.title, loading: 'lazy' }}
              {%- endif -%}
            </div>
            <div class="pet-product-card-full__body">
              <h3 class="pet-product-card-full__title">{{ product.title }}</h3>
              <div class="pet-product-card-full__rating">
                <span class="pet-product-card-full__stars">★★★★★</span>
              </div>
              <div class="pet-product-card-full__price-row">
                <span class="pet-product-card-full__price">{{ product.price | money }}</span>
                <span class="pet-product-card-full__btn">{{ 'custom.all_products.view_details' | t }}</span>
              </div>
            </div>
          </a>
        {%- else -%}
          <p style="grid-column: 1 / -1; text-align: center; color: #6b7280;">{{ 'custom.all_products.no_products' | t }}</p>
        {%- endfor -%}
      </div>

      {%- if paginate.pages > 1 -%}
        <nav class="pet-all-products-pagination" aria-label="{{ 'custom.all_products.pagination_label' | t }}">
          {%- if paginate.previous -%}
            <a href="{{ paginate.previous.url }}" class="pet-all-products-pagination__link">‹</a>
          {%- else -%}
            <span class="pet-all-products-pagination__link is-disabled">‹</span>
          {%- endif -%}

          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              <a href="{{ part.url }}" class="pet-all-products-pagination__link">{{ part.title }}</a>
            {%- else -%}
              {%- if part.title == paginate.current_page -%}
                <span class="pet-all-products-pagination__link is-active">{{ part.title }}</span>
              {%- else -%}
                <span class="pet-all-products-pagination__ellipsis">{{ part.title }}</span>
              {%- endif -%}
            {%- endif -%}
          {%- endfor -%}

          {%- if paginate.next -%}
            <a href="{{ paginate.next.url }}" class="pet-all-products-pagination__link">›</a>
          {%- else -%}
            <span class="pet-all-products-pagination__link is-disabled">›</span>
          {%- endif -%}
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </div>
</section>

{% schema %}
{
  "name": "Custom all products",
  "presets": [
    {
      "name": "Custom all products"
    }
  ]
}
{% endschema %}
