{%- style -%}
  .pet-all-products-section {
    padding: 5rem 2rem;
    background-color: #f9fafb;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  }

  .pet-all-products-container {
    max-width: 1050px;
    margin: 0 auto;
  }

  .pet-all-products-header {
    text-align: center;
    margin-bottom: 2.8rem;
  }

  .pet-all-products-header h1 {
    font-size: 3.2rem;
    font-weight: 800;
    color: #111827;
    margin: 0 0 0.6rem 0;
    letter-spacing: -0.02em;
  }

  .pet-all-products-header p {
    font-size: 1.4rem;
    color: #6b7280;
    margin: 0;
  }

  .pet-all-products-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }

  .pet-product-card-full {
    background-color: #ffffff;
    border-radius: 1.4rem;
    border: 1px solid #e5e7eb;
    overflow: hidden;
    display: flex;
    flex-direction: column;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
    padding: 1rem;
  }

  .pet-product-card-full:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
  }

  .pet-product-card-full__image-box {
    position: relative;
    width: 100%;
    height: 190px;
    background-color: #f9fafb;
    border-radius: 1rem;
    padding: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
    border: 1px solid #f0f0f4;
  }

  .pet-product-card-full__image-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .pet-product-card-full:hover .pet-product-card-full__image-box img {
    transform: scale(1.05);
  }

  .pet-product-card-full__body {
    padding-top: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
    flex-grow: 1;
  }

  .pet-product-card-full__title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #111827;
    line-height: 1.3;
    margin: 0;
    height: 3.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pet-product-card-full:hover .pet-product-card-full__title {
    color: #4c46c4;
  }

  .pet-product-card-full__rating {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 1.15rem;
    color: #6b7280;
  }

  .pet-product-card-full__stars {
    color: #ea580c;
    font-weight: 700;
  }

  .pet-card__badges {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    flex-wrap: wrap;
    margin-top: 0.2rem;
  }

  .pet-badge {
    display: inline-flex;
    align-items: center;
    gap: 0.3rem;
    padding: 0.25rem 0.6rem;
    border-radius: 0.4rem;
    border: 1px solid #e5e7eb;
    background-color: #ffffff;
    font-size: 1.1rem;
    font-weight: 600;
    color: #4b5563;
  }

  .pet-product-card-full__price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: auto;
    padding-top: 0.6rem;
  }

  .pet-product-card-full__price {
    font-size: 1.6rem;
    font-weight: 800;
    color: #4c46c4;
  }

  .pet-product-card-full__btn {
    padding: 0.6rem 1.4rem;
    background-color: #4c46c4;
    color: #ffffff;
    border: none;
    border-radius: 2rem;
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    transition: all 0.2s ease;
    box-shadow: 0 3px 8px rgba(76, 70, 196, 0.25);
  }

  .pet-product-card-full__btn:hover {
    background-color: #3b35ad;
    box-shadow: 0 5px 14px rgba(76, 70, 196, 0.4);
  }

  @media screen and (max-width: 989px) {
    .pet-all-products-grid { grid-template-columns: repeat(2, 1fr); }
  }

  @media screen and (max-width: 576px) {
    .pet-all-products-grid { grid-template-columns: 1fr; }
  }
{%- endstyle -%}

