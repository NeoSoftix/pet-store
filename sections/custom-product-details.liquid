{%- style -%}
  .pet-pdp-section {
    padding: 3rem 2.4rem 6rem;
    background-color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #111827;
  }

  .pet-pdp-container {
    max-width: 1300px;
    margin: 0 auto;
  }

  /* BREADCRUMB */
  .pet-breadcrumb {
    font-size: 1.3rem;
    color: #6b7280;
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .pet-breadcrumb a {
    color: #4b5563;
    text-decoration: none;
  }

  .pet-breadcrumb a:hover {
    color: #4c46c4;
  }

  .pet-breadcrumb__sep {
    color: #d1d5db;
  }

  /* MAIN PDP GRID (Thumbnails + Main Img + Info) */
  .pet-pdp-main-grid {
    display: grid;
    grid-template-columns: 100px 1fr 1fr;
    gap: 3rem;
    margin-bottom: 8rem;
    align-items: start;
  }

  /* VERTICAL THUMBNAIL COLUMN */
  .pet-pdp-thumbs-col {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .pet-pdp-thumb-box {
    width: 80px;
    height: 80px;
    border-radius: 1.2rem;
    border: 2px solid #e5e7eb;
    background-color: #f9fafb;
    padding: 0.6rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .pet-pdp-thumb-box.active,
  .pet-pdp-thumb-box:hover {
    border-color: #4c46c4;
    box-shadow: 0 4px 12px rgba(76, 70, 196, 0.15);
  }

  .pet-pdp-thumb-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* MAIN IMAGE BOX */
  .pet-pdp-main-img-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f9fafb;
    border-radius: 2rem;
    border: 1px solid #f0f0f4;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem;
  }

  .pet-pdp-main-img-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* RIGHT INFO COLUMN */
  .pet-pdp-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .pet-pdp-vendor {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #6b7280;
  }

  .pet-pdp-title {
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1.2;
    color: #111827;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .pet-pdp-price-row {
    display: flex;
    align-items: baseline;
    gap: 1.4rem;
  }

  .pet-pdp-price {
    font-size: 2.8rem;
    font-weight: 900;
    color: #111827;
  }

  .pet-pdp-compare-price {
    font-size: 1.8rem;
    color: #9ca3af;
    text-decoration: line-through;
  }

  /* 2-COLUMN FEATURES GRID (Matches petsroyalty screenshot!) */
  .pet-pdp-features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
    background-color: #fafafa;
    padding: 2rem;
    border-radius: 1.6rem;
    border: 1px solid #f0f0f4;
  }

  .pet-pdp-feature-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.35rem;
    font-weight: 600;
    color: #374151;
  }

  .pet-pdp-feature-icon {
    font-size: 1.6rem;
  }

  /* OPTION SWATCHES */
  .pet-pdp-option-group {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .pet-pdp-option-label {
    font-size: 1.4rem;
    font-weight: 700;
    color: #111827;
  }

  .pet-pdp-swatches {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pet-pdp-swatch-circle {
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    border: 2px solid #e5e7eb;
    background-color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .pet-pdp-swatch-circle.active {
    border-color: #111827;
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px #111827;
  }

  .pet-pdp-swatch-inner {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background-color: #e2e8f0;
  }

  /* QUANTITY & BUY BUTTONS */
  .pet-pdp-actions-row {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .pet-pdp-qty-stepper {
    display: flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: 3rem;
    padding: 0.4rem 1.4rem;
    gap: 1.6rem;
    background-color: #ffffff;
    height: 4.8rem;
  }

  .pet-pdp-qty-btn {
    background: none;
    border: none;
    font-size: 1.8rem;
    font-weight: 700;
    color: #4b5563;
    cursor: pointer;
  }

  .pet-pdp-qty-val {
    font-size: 1.6rem;
    font-weight: 700;
    color: #111827;
    min-width: 2rem;
    text-align: center;
  }

  .pet-pdp-add-cart-btn {
    flex-grow: 1;
    height: 4.8rem;
    border-radius: 3rem;
    background-color: #111827;
    color: #ffffff;
    border: none;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .pet-pdp-add-cart-btn:hover {
    background-color: #4c46c4;
  }

  .pet-pdp-shop-pay-btn {
    width: 100%;
    height: 4.8rem;
    border-radius: 3rem;
    background-color: #5a31f4;
    color: #ffffff;
    border: none;
    font-size: 1.6rem;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    box-shadow: 0 4px 14px rgba(90, 49, 244, 0.3);
  }

  /* ACCORDIONS */
  .pet-pdp-accordions {
    border-top: 1px solid #e5e7eb;
    margin-top: 1rem;
  }

  .pet-pdp-accordion-item {
    border-bottom: 1px solid #e5e7eb;
  }

  .pet-pdp-accordion-header {
    width: 100%;
    padding: 1.8rem 0;
    background: none;
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.6rem;
    font-weight: 700;
    color: #111827;
    cursor: pointer;
  }

  .pet-pdp-accordion-body {
    padding-bottom: 2rem;
    font-size: 1.45rem;
    color: #4b5563;
    line-height: 1.6;
    display: none;
  }

  .pet-pdp-accordion-item.active .pet-pdp-accordion-body {
    display: block;
  }

  /* RELATED PRODUCTS SECTION BELOW */
  .pet-related-section {
    border-top: 1px solid #e5e7eb;
    padding-top: 6rem;
    margin-top: 6rem;
  }

  .pet-related-title {
    font-size: 3.6rem;
    font-weight: 800;
    color: #111827;
    text-align: center;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .pet-card-rel {
    background-color: #ffffff;
    border-radius: 2rem;
    border: 1px solid #e5e7eb;
    padding: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    cursor: pointer;
    transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.04);
  }

  .pet-card-rel:hover {
    transform: translateY(-6px);
    box-shadow: 0 16px 36px rgba(0, 0, 0, 0.08);
  }

  .pet-card-rel__img-wrapper {
    position: relative;
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f9fafb;
    border-radius: 1.4rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 2rem;
    overflow: hidden;
    border: 1px solid #f0f0f4;
  }

  .pet-card-rel__img-wrapper img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.35s ease;
  }

  .pet-card-rel:hover .pet-card-rel__img-wrapper img {
    transform: scale(1.06);
  }

  .pet-card-rel__btn {
    width: 100%;
    padding: 1.2rem;
    border-radius: 3rem;
    background-color: #4c46c4;
    color: #ffffff;
    border: none;
    font-size: 1.45rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: auto;
    transition: all 0.2s ease;
    box-shadow: 0 4px 12px rgba(76, 70, 196, 0.25);
  }

  .pet-card-rel:hover .pet-card-rel__btn {
    background-color: #3b35ad;
    box-shadow: 0 6px 18px rgba(76, 70, 196, 0.4);
  }

  @media screen and (max-width: 989px) {
    .pet-pdp-main-grid {
      grid-template-columns: 1fr;
    }
    .pet-pdp-thumbs-col {
      flex-direction: row;
    }
  }
{%- endstyle -%}

