{%- style -%}
  .pet-pdp-section {
    padding: 3rem 2.4rem 6rem;
    background-color: #ffffff;
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    color: #111827;
  }

  .pet-pdp-container {
    max-width: 1300px;
    margin: 0 auto;
  }

  /* BREADCRUMB */
  .pet-breadcrumb {
    font-size: 1.3rem;
    color: #6b7280;
    margin-bottom: 3rem;
    display: flex;
    align-items: center;
    gap: 0.8rem;
  }

  .pet-breadcrumb a {
    color: #4b5563;
    text-decoration: none;
  }

  .pet-breadcrumb a:hover {
    color: #4c46c4;
  }

  .pet-breadcrumb__sep {
    color: #d1d5db;
  }

  /* MAIN PDP GRID (Thumbnails + Main Img + Info) */
  .pet-pdp-main-grid {
    display: grid;
    grid-template-columns: 100px 1fr 1fr;
    gap: 3rem;
    margin-bottom: 8rem;
    align-items: start;
  }

  /* VERTICAL THUMBNAIL COLUMN */
  .pet-pdp-thumbs-col {
    display: flex;
    flex-direction: column;
    gap: 1.2rem;
  }

  .pet-pdp-thumb-box {
    width: 80px;
    height: 80px;
    border-radius: 1.2rem;
    border: 2px solid #e5e7eb;
    background-color: #f9fafb;
    padding: 0.6rem;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .pet-pdp-thumb-box.active,
  .pet-pdp-thumb-box:hover {
    border-color: #4c46c4;
    box-shadow: 0 4px 12px rgba(76, 70, 196, 0.15);
  }

  .pet-pdp-thumb-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* MAIN IMAGE BOX */
  .pet-pdp-main-img-box {
    width: 100%;
    aspect-ratio: 1 / 1;
    background-color: #f9fafb;
    border-radius: 2rem;
    border: 1px solid #f0f0f4;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 3rem;
  }

  .pet-pdp-main-img-box img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
  }

  /* RIGHT INFO COLUMN */
  .pet-pdp-info-col {
    display: flex;
    flex-direction: column;
    gap: 1.8rem;
  }

  .pet-pdp-vendor {
    font-size: 1.2rem;
    font-weight: 700;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #6b7280;
  }

  .pet-pdp-title {
    font-size: 3.2rem;
    font-weight: 800;
    line-height: 1.2;
    color: #111827;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .pet-pdp-price-row {
    display: flex;
    align-items: baseline;
    gap: 1.4rem;
  }

  .pet-pdp-price {
    font-size: 2.8rem;
    font-weight: 900;
    color: #111827;
  }

  .pet-pdp-compare-price {
    font-size: 1.8rem;
    color: #9ca3af;
    text-decoration: line-through;
  }

  /* 2-COLUMN FEATURES GRID (Matches petsroyalty screenshot!) */
  .pet-pdp-features-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.4rem;
    background-color: #fafafa;
    padding: 2rem;
    border-radius: 1.6rem;
    border: 1px solid #f0f0f4;
  }

  .pet-pdp-feature-item {
    display: flex;
    align-items: center;
    gap: 1rem;
    font-size: 1.35rem;
    font-weight: 600;
    color: #374151;
  }

  .pet-pdp-feature-icon {
    font-size: 1.6rem;
  }

  /* OPTION SWATCHES */
  .pet-pdp-option-group {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .pet-pdp-option-label {
    font-size: 1.4rem;
    font-weight: 700;
    color: #111827;
  }

  .pet-pdp-swatches {
    display: flex;
    align-items: center;
    gap: 1rem;
  }

  .pet-pdp-swatch-circle {
    width: 3.6rem;
    height: 3.6rem;
    border-radius: 50%;
    border: 2px solid #e5e7eb;
    background-color: #ffffff;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.2s ease;
  }

  .pet-pdp-swatch-circle.active {
    border-color: #111827;
    box-shadow: 0 0 0 2px #ffffff, 0 0 0 4px #111827;
  }

  .pet-pdp-swatch-inner {
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background-color: #e2e8f0;
  }

  .pet-pdp-swatch-circle--text {
    width: auto;
    min-width: 3.6rem;
    height: 3.6rem;
    border-radius: 1.8rem;
    padding: 0 1.4rem;
    font-size: 1.3rem;
    font-weight: 700;
    color: #111827;
  }

  /* QUANTITY & BUY BUTTONS */
  .pet-pdp-actions-row {
    display: flex;
    align-items: center;
    gap: 1.6rem;
  }

  .pet-pdp-qty-stepper {
    display: flex;
    align-items: center;
    border: 1px solid #d1d5db;
    border-radius: 3rem;
    padding: 0.4rem 1.4rem;
    gap: 1.6rem;
    background-color: #ffffff;
    height: 4.8rem;
  }

  .pet-pdp-qty-btn {
    background: none;
    border: none;
    font-size: 1.8rem;
    font-weight: 700;
    color: #4b5563;
    cursor: pointer;
  }

  .pet-pdp-qty-val {
    font-size: 1.6rem;
    font-weight: 700;
    color: #111827;
    min-width: 2rem;
    text-align: center;
  }

  .pet-pdp-add-cart-btn {
    flex-grow: 1;
    height: 4.8rem;
    border-radius: 3rem;
    background-color: #111827;
    color: #ffffff;
    border: none;
    font-size: 1.5rem;
    font-weight: 800;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    cursor: pointer;
    transition: background-color 0.2s ease;
  }

  .pet-pdp-add-cart-btn:hover {
    background-color: #4c46c4;
  }

  .pet-pdp-shop-pay-btn {
    width: 100%;
    height: 4.8rem;
    border-radius: 3rem;
    background-color: #5a31f4;
    color: #ffffff;
    border: none;
    font-size: 1.6rem;
    font-weight: 800;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    box-shadow: 0 4px 14px rgba(90, 49, 244, 0.3);
  }

  /* ACCORDIONS */
  .pet-pdp-accordions {
    border-top: 1px solid #e5e7eb;
    margin-top: 1rem;
  }

  .pet-pdp-accordion-item {
    border-bottom: 1px solid #e5e7eb;
  }

  .pet-pdp-accordion-header {
    width: 100%;
    padding: 1.8rem 0;
    background: none;
    border: none;
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-size: 1.6rem;
    font-weight: 700;
    color: #111827;
    cursor: pointer;
  }

  .pet-pdp-accordion-body {
    padding-bottom: 2rem;
    font-size: 1.45rem;
    color: #4b5563;
    line-height: 1.6;
    display: none;
  }

  .pet-pdp-accordion-item.active .pet-pdp-accordion-body {
    display: block;
  }

  /* ===== Product description content (raw HTML from product body) ===== */
  .pet-pdp-accordion-body h1,
  .pet-pdp-accordion-body h2,
  .pet-pdp-accordion-body h3,
  .pet-pdp-accordion-body h4,
  .pet-pdp-accordion-body h5,
  .pet-pdp-accordion-body h6 {
    font-weight: 800;
    color: #111827;
    line-height: 1.3;
    letter-spacing: -0.01em;
    margin: 2.4rem 0 1rem;
  }

  .pet-pdp-accordion-body h1:first-child,
  .pet-pdp-accordion-body h2:first-child,
  .pet-pdp-accordion-body h3:first-child,
  .pet-pdp-accordion-body h4:first-child {
    margin-top: 0;
  }

  .pet-pdp-accordion-body h1 { font-size: 2.4rem; }
  .pet-pdp-accordion-body h2 { font-size: 2.1rem; }
  .pet-pdp-accordion-body h3 { font-size: 1.8rem; }
  .pet-pdp-accordion-body h4,
  .pet-pdp-accordion-body h5,
  .pet-pdp-accordion-body h6 { font-size: 1.6rem; }

  .pet-pdp-accordion-body p {
    margin: 0 0 1.4rem;
  }

  .pet-pdp-accordion-body p:last-child {
    margin-bottom: 0;
  }

  .pet-pdp-accordion-body ul,
  .pet-pdp-accordion-body ol {
    margin: 0 0 1.6rem;
    padding-left: 2.2rem;
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .pet-pdp-accordion-body li {
    line-height: 1.6;
  }

  .pet-pdp-accordion-body strong,
  .pet-pdp-accordion-body b {
    color: #111827;
    font-weight: 700;
  }

  .pet-pdp-accordion-body a {
    color: #4c46c4;
    text-decoration: underline;
  }

  .pet-pdp-accordion-body img {
    max-width: 100%;
    height: auto;
    display: block;
    border-radius: 1.4rem;
    margin: 2rem 0;
  }

  .pet-pdp-accordion-body table {
    width: 100%;
    border-collapse: collapse;
    margin: 0 0 1.6rem;
    font-size: 1.35rem;
  }

  .pet-pdp-accordion-body table td,
  .pet-pdp-accordion-body table th {
    border: 1px solid #e5e7eb;
    padding: 0.8rem 1.2rem;
    text-align: left;
  }

  .pet-pdp-accordion-body hr {
    border: none;
    border-top: 1px solid #e5e7eb;
    margin: 2rem 0;
  }

  /* RELATED PRODUCTS SECTION BELOW */
  .pet-related-section {
    border-top: 1px solid #e5e7eb;
    padding-top: 5rem;
    margin-top: 5rem;
  }

  .pet-related-title {
    font-size: 3.2rem;
    font-weight: 800;
    color: #111827;
    text-align: center;
    margin: 0;
    letter-spacing: -0.02em;
  }

  .pet-product-grid-3 {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
    max-width: 1050px;
    margin: 0 auto;
  }

  .pet-card-rel {
    background-color: #ffffff;
    border-radius: 1.4rem;
    border: 1px solid #e5e7eb;
    padding: 1rem;
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
    cursor: pointer;
    text-decoration: none;
    color: inherit;
    transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    box-shadow: 0 3px 12px rgba(0, 0, 0, 0.03);
  }

  .pet-card-rel:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 24px rgba(0, 0, 0, 0.08);
  }

  .pet-card-rel__img-wrapper {
    position: relative;
    width: 100%;
    height: 190px;
    background-color: #f9fafb;
    border-radius: 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1rem;
    overflow: hidden;
    border: 1px solid #f0f0f4;
  }

  .pet-card-rel__img-wrapper img {
    max-width: 100%;
    max-height: 100%;
    object-fit: contain;
    transition: transform 0.3s ease;
  }

  .pet-card-rel:hover .pet-card-rel__img-wrapper img {
    transform: scale(1.05);
  }

  .pet-card-rel__title {
    font-size: 1.4rem;
    font-weight: 700;
    color: #111827;
    line-height: 1.3;
    margin: 0;
    height: 3.6rem;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .pet-card-rel__btn {
    display: block;
    width: 100%;
    text-align: center;
    box-sizing: border-box;
    padding: 0.6rem 1.4rem;
    border-radius: 2rem;
    background-color: #4c46c4;
    color: #ffffff;
    border: none;
    font-size: 1.2rem;
    font-weight: 700;
    cursor: pointer;
    margin-top: auto;
    transition: all 0.2s ease;
    box-shadow: 0 3px 8px rgba(76, 70, 196, 0.25);
  }

  .pet-card-rel:hover .pet-card-rel__btn {
    background-color: #3b35ad;
    box-shadow: 0 5px 14px rgba(76, 70, 196, 0.4);
  }

  @media screen and (max-width: 989px) {
    .pet-pdp-section {
      padding: 2.5rem 1.6rem 4rem;
    }

    .pet-product-grid-3 {
      grid-template-columns: repeat(2, 1fr);
    }

    .pet-pdp-main-grid {
      grid-template-columns: 1fr;
      gap: 2rem;
      margin-bottom: 5rem;
    }

    .pet-pdp-thumbs-col {
      flex-direction: row;
      order: 2;
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 0.4rem;
    }

    .pet-pdp-thumb-box {
      flex: 0 0 auto;
    }

    .pet-pdp-main-img-box {
      order: 1;
    }

    .pet-pdp-info-col {
      order: 3;
    }

    .pet-pdp-title {
      font-size: 2.6rem;
    }
  }

  @media screen and (max-width: 749px) {
    .pet-pdp-section {
      padding: 2rem 1.2rem 3rem;
    }

    .pet-breadcrumb {
      margin-bottom: 1.6rem;
      font-size: 1.15rem;
      flex-wrap: wrap;
    }

    .pet-pdp-main-grid {
      gap: 1.6rem;
      margin-bottom: 3.5rem;
    }

    .pet-pdp-main-img-box {
      padding: 1.6rem;
      border-radius: 1.4rem;
    }

    .pet-pdp-thumb-box {
      width: 60px;
      height: 60px;
      border-radius: 0.9rem;
    }

    .pet-pdp-title {
      font-size: 2.1rem;
    }

    .pet-pdp-price {
      font-size: 2.2rem;
    }

    .pet-pdp-compare-price {
      font-size: 1.5rem;
    }

    .pet-pdp-features-grid {
      grid-template-columns: 1fr;
      padding: 1.4rem;
      gap: 1rem;
    }

    .pet-pdp-feature-item {
      font-size: 1.2rem;
    }

    .pet-pdp-actions-row {
      flex-wrap: wrap;
      gap: 1rem;
    }

    .pet-pdp-qty-stepper {
      height: 4.4rem;
      flex: 0 0 auto;
    }

    .pet-pdp-add-cart-btn {
      flex-basis: 100%;
      height: 4.4rem;
      font-size: 1.3rem;
    }

    .pet-pdp-shop-pay-btn {
      height: 4.4rem;
      font-size: 1.4rem;
    }

    .pet-related-section {
      padding-top: 3rem;
      margin-top: 3rem;
    }

    .pet-related-title {
      font-size: 2.2rem;
    }

    .pet-product-grid-3 {
      grid-template-columns: repeat(2, 1fr);
      gap: 1.2rem;
    }

    .pet-card-rel__img-wrapper {
      height: 140px;
    }

    .pet-card-rel__title {
      font-size: 1.2rem;
      height: 3.1rem;
    }
  }

  @media screen and (max-width: 480px) {
    .pet-pdp-title {
      font-size: 1.9rem;
    }

    .pet-pdp-price {
      font-size: 1.9rem;
    }

    .pet-pdp-swatch-circle {
      width: 3.2rem;
      height: 3.2rem;
    }

    .pet-pdp-swatch-inner {
      width: 2.3rem;
      height: 2.3rem;
    }

    .pet-pdp-qty-stepper {
      padding: 0.4rem 1rem;
      gap: 1.2rem;
    }

    .pet-product-grid-3 {
      grid-template-columns: 1fr;
    }

    .pet-card-rel__img-wrapper {
      height: 190px;
    }
  }
{%- endstyle -%}

<section class="pet-pdp-section">
  <div class="pet-pdp-container">
    <!-- Breadcrumb -->
    <nav class="pet-breadcrumb">
      <a href="/">{{ 'custom.product_details.breadcrumb_home' | t }}</a>
      <span class="pet-breadcrumb__sep">/</span>
      <a href="/collections/all">{{ 'custom.product_details.breadcrumb_essentials' | t }}</a>
      <span class="pet-breadcrumb__sep">/</span>
      <span id="pdpBreadcrumbTitle">{{ product.title }}</span>
    </nav>

    <!-- Main PDP Grid -->
    <div class="pet-pdp-main-grid">
      <!-- 1. Left Vertical Thumbnails Column -->
      <div class="pet-pdp-thumbs-col" id="pdpThumbsCol">
        {%- for image in product.images -%}
          <div class="pet-pdp-thumb-box{% if forloop.first %} active{% endif %}" onclick="switchPdpImage({{ forloop.index0 }})">
            <img src="{{ image | image_url: width: 200 }}" data-full="{{ image | image_url: width: 1200 }}" alt="{{ 'custom.product_details.thumb_alt' | t }} {{ forloop.index }}">
          </div>
        {%- endfor -%}
      </div>

      <!-- 2. Center Main Image Container -->
      <div class="pet-pdp-main-img-box">
        <img id="pdpMainImg" src="{{ product.featured_image | image_url: width: 1200 }}" alt="{{ product.title | escape }}">
      </div>

      <!-- 3. Right Product Info Column -->
      <div class="pet-pdp-info-col">
        <div class="pet-pdp-vendor">{{ product.vendor }}</div>
        <h1 class="pet-pdp-title" id="pdpTitle">{{ product.title }}</h1>

        <div class="pet-pdp-price-row">
          <span class="pet-pdp-price" id="pdpPrice">{{ product.selected_or_first_available_variant.price | money }}</span>
          <span class="pet-pdp-compare-price" id="pdpCompare" {% unless product.selected_or_first_available_variant.compare_at_price > product.selected_or_first_available_variant.price %}style="display:none;"{% endunless %}>{{ product.selected_or_first_available_variant.compare_at_price | money }}</span>
        </div>

        <!-- 2-Column Feature Icons Grid (Matches petsroyalty screenshot!) -->
        <div class="pet-pdp-features-grid">
          <div class="pet-pdp-feature-item"><span class="pet-pdp-feature-icon">⭐</span> {{ 'custom.product_details.feature_premium_quality' | t }}</div>
          <div class="pet-pdp-feature-item"><span class="pet-pdp-feature-icon">🛡️</span> {{ 'custom.product_details.feature_pet_safe' | t }}</div>
          <div class="pet-pdp-feature-item"><span class="pet-pdp-feature-icon">🔨</span> {{ 'custom.product_details.feature_durable_build' | t }}</div>
          <div class="pet-pdp-feature-item"><span class="pet-pdp-feature-icon">⚡</span> {{ 'custom.product_details.feature_all_in_one' | t }}</div>
          <div class="pet-pdp-feature-item"><span class="pet-pdp-feature-icon">🔧</span> {{ 'custom.product_details.feature_practical' | t }}</div>
          <div class="pet-pdp-feature-item"><span class="pet-pdp-feature-icon">💰</span> {{ 'custom.product_details.feature_value' | t }}</div>
        </div>

        <!-- Option Swatches -->
        {%- unless product.has_only_default_variant -%}
          {%- for option in product.options_with_values -%}
            <div class="pet-pdp-option-group">
              <div class="pet-pdp-option-label">{{ option.name }}: <span style="font-weight:400;" data-selected-value>{{ option.selected_value }}</span></div>
              <div class="pet-pdp-swatches">
                {%- assign option_index = forloop.index0 -%}
                {%- for value in option.values -%}
                  {%- if option.name == 'Color' or option.name == 'Colour' -%}
                    <div class="pet-pdp-swatch-circle{% if value == option.selected_value %} active{% endif %}" onclick='selectPdpOption({{ option_index }}, {{ value | json }}, this)'>
                      <div class="pet-pdp-swatch-inner" style="background: {{ value | downcase }};"></div>
                    </div>
                  {%- else -%}
                    <div class="pet-pdp-swatch-circle pet-pdp-swatch-circle--text{% if value == option.selected_value %} active{% endif %}" onclick='selectPdpOption({{ option_index }}, {{ value | json }}, this)'>{{ value }}</div>
                  {%- endif -%}
                {%- endfor -%}
              </div>
            </div>
          {%- endfor -%}
        {%- endunless -%}

        <!-- Quantity & Add to Cart -->
        <div class="pet-pdp-actions-row" id="pdpActionsRow" data-variant-id="{{ product.selected_or_first_available_variant.id }}">
          <div class="pet-pdp-qty-stepper">
            <button class="pet-pdp-qty-btn" type="button" onclick="adjustPdpQty(-1)">-</button>
            <span class="pet-pdp-qty-val" id="pdpQtyVal">1</span>
            <button class="pet-pdp-qty-btn" type="button" onclick="adjustPdpQty(1)">+</button>
          </div>
          <button class="pet-pdp-add-cart-btn" type="button" id="pdpAddCartBtn" onclick="handlePdpAddToCart()">{{ 'custom.product_details.add_to_cart' | t }}</button>
        </div>

        <button class="pet-pdp-shop-pay-btn" type="button" id="pdpBuyNowBtn" onclick="handlePdpCheckout()">
          {{ 'custom.product_details.buy_with' | t }} <strong>{{ 'custom.product_details.shop_pay_stripe' | t }}</strong>
        </button>

        <div id="pdpCartError" style="display:none; margin-top:1.2rem; padding:1.2rem; background:#fef2f2; border:1px solid #ef4444; color:#991b1b; border-radius:0.8rem; font-size:1.4rem; font-weight:700; text-align:center;"></div>

        <div id="pdpCartToast" style="display:none; margin-top:1.2rem; padding:1.2rem; background:#ecfdf5; border:1px solid #10b981; color:#065f46; border-radius:0.8rem; font-size:1.4rem; font-weight:700; text-align:center;">
          ✅ {{ 'custom.product_details.toast_added_redirect' | t }}
        </div>

        <!-- Accordions -->
        <div class="pet-pdp-accordions">
          <div class="pet-pdp-accordion-item">
            <button class="pet-pdp-accordion-header" onclick="togglePdpAccordion(this)">
              <span>{{ 'custom.product_details.accordion_description' | t }}</span>
              <span>+</span>
            </button>
            <div class="pet-pdp-accordion-body" id="pdpFullDesc">
              {{ product.description }}
            </div>
          </div>

          <div class="pet-pdp-accordion-item">
            <button class="pet-pdp-accordion-header" onclick="togglePdpAccordion(this)">
              <span>{{ 'custom.product_details.accordion_shipping' | t }}</span>
              <span>+</span>
            </button>
            <div class="pet-pdp-accordion-body">
              {{ 'custom.product_details.shipping_text' | t }}
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Related Products Section (Shows other CSV products below!) -->
    <div class="pet-related-section">
      <div style="text-align: center; margin-bottom: 4rem;">
        <span style="display:inline-block; padding:0.4rem 1.6rem; background:#e0e7ff; color:#4c46c4; font-size:1.3rem; font-weight:700; border-radius:2rem; text-transform:uppercase; letter-spacing:0.05em; margin-bottom:1rem;">{{ 'custom.product_details.related_badge' | t }}</span>
        <h2 class="pet-related-title">{{ 'custom.product_details.related_heading' | t }}</h2>
      </div>

      <div class="pet-product-grid-3">
        {%- assign related_count = 0 -%}
        {%- for related in collections.all.products -%}
          {%- if related.id != product.id and related_count < 3 -%}
            {%- assign related_count = related_count | plus: 1 -%}
            <a href="{{ related.url }}" class="pet-card-rel">
              <div class="pet-card-rel__img-wrapper">
                {%- if related.featured_image -%}
                  <img src="{{ related.featured_image | image_url: width: 400 }}" alt="{{ related.title | escape }}">
                {%- endif -%}
              </div>
              <div style="display:flex; flex-direction:column; gap:0.4rem; flex-grow:1;">
                <h3 class="pet-card-rel__title">{{ related.title }}</h3>
                <div style="display:flex; align-items:baseline; gap:0.6rem; margin-top:0.2rem;">
                  <span style="font-size:1.6rem; font-weight:800; color:#4c46c4;">{{ related.price | money }}</span>
                  {%- if related.compare_at_price > related.price -%}
                    <span style="font-size:1.2rem; color:#9ca3af; text-decoration:line-through;">{{ related.compare_at_price | money }}</span>
                  {%- endif -%}
                </div>
              </div>
              <span class="pet-card-rel__btn">{{ 'custom.product_details.view_details_shop' | t }}</span>
            </a>
          {%- endif -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

<script>
  var pdpVariants = [
    {%- for variant in product.variants -%}
    {
      id: {{ variant.id }},
      price: {{ variant.price | money | json }},
      compareAtPrice: {%- if variant.compare_at_price > variant.price -%}{{ variant.compare_at_price | money | json }}{%- else -%}null{%- endif -%},
      image: {%- if variant.featured_image -%}{{ variant.featured_image | image_url: width: 1200 | json }}{%- else -%}null{%- endif -%},
      options: {{ variant.options | json }}
    }{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];

  var pdpSelectedOptions = [
    {%- for option in product.options_with_values -%}
      {{ option.selected_value | json }}{%- unless forloop.last -%},{%- endunless -%}
    {%- endfor -%}
  ];

  function switchPdpImage(idx) {
    var mainImg = document.getElementById('pdpMainImg');
    var thumbs = document.querySelectorAll('.pet-pdp-thumb-box');
    if (thumbs[idx]) {
      thumbs.forEach(function(t){ t.classList.remove('active'); });
      thumbs[idx].classList.add('active');
      var img = thumbs[idx].querySelector('img');
      mainImg.src = img.getAttribute('data-full') || img.src;
    }
  }

  function selectPdpOption(optionIndex, value, el) {
    pdpSelectedOptions[optionIndex] = value;

    var group = el.closest('.pet-pdp-option-group');
    if (group) {
      group.querySelectorAll('.pet-pdp-swatch-circle').forEach(function (s) { s.classList.remove('active'); });
      el.classList.add('active');
      var label = group.querySelector('[data-selected-value]');
      if (label) label.textContent = value;
    }

    var match = pdpVariants.find(function (v) {
      return v.options.every(function (optVal, i) { return optVal === pdpSelectedOptions[i]; });
    });
    if (!match) return;

    var actionsRow = document.getElementById('pdpActionsRow');
    if (actionsRow) actionsRow.setAttribute('data-variant-id', match.id);

    var priceEl = document.getElementById('pdpPrice');
    var compareEl = document.getElementById('pdpCompare');
    if (priceEl) priceEl.textContent = match.price;
    if (compareEl) {
      if (match.compareAtPrice) {
        compareEl.textContent = match.compareAtPrice;
        compareEl.style.display = '';
      } else {
        compareEl.style.display = 'none';
      }
    }

    if (match.image) {
      document.getElementById('pdpMainImg').src = match.image;
    }
  }

  function adjustPdpQty(delta) {
    var valEl = document.getElementById('pdpQtyVal');
    var currentVal = parseInt(valEl.innerText) || 1;
    var newVal = Math.max(1, currentVal + delta);
    valEl.innerText = newVal;
  }

  function togglePdpAccordion(btn) {
    var item = btn.parentElement;
    var isOpen = item.classList.contains('active');
    item.classList.toggle('active');
    btn.querySelector('span:last-child').innerText = isOpen ? '+' : '−';
  }

  function pdpAddToCart(redirectToCheckout) {
    var actionsRow = document.getElementById('pdpActionsRow');
    var variantId = actionsRow ? actionsRow.getAttribute('data-variant-id') : '';
    var qty = parseInt(document.getElementById('pdpQtyVal').innerText, 10) || 1;
    var errorBox = document.getElementById('pdpCartError');
    var toast = document.getElementById('pdpCartToast');
    var addBtn = document.getElementById('pdpAddCartBtn');
    var buyBtn = document.getElementById('pdpBuyNowBtn');

    if (errorBox) errorBox.style.display = 'none';
    if (toast) toast.style.display = 'none';
    if (!variantId) {
      if (errorBox) {
        errorBox.innerText = '{{ "custom.product_details.error_no_variant" | t }}';
        errorBox.style.display = 'block';
      }
      return;
    }

    if (addBtn) addBtn.disabled = true;
    if (buyBtn) buyBtn.disabled = true;

    fetch('/cart/add.js', {
      method: 'POST',
      headers: { 'Content-Type': 'application/json', 'Accept': 'application/json' },
      body: JSON.stringify({ items: [{ id: variantId, quantity: qty }] })
    })
      .then(function (res) {
        if (!res.ok) {
          return res.json().then(function (err) {
            throw new Error(err.description || err.message || 'Add to cart failed');
          });
        }
        return res.json();
      })
      .then(function () {
        if (redirectToCheckout) {
          window.location.href = '/checkout';
          return;
        }
        if (toast) {
          toast.innerText = '✅ {{ "custom.product_details.toast_added_redirect" | t }}';
          toast.style.display = 'block';
        }
        if (addBtn) addBtn.disabled = false;
        if (buyBtn) buyBtn.disabled = false;
      })
      .catch(function (err) {
        if (errorBox) {
          errorBox.innerText = err.message || '{{ "custom.product_details.error_add_failed" | t }}';
          errorBox.style.display = 'block';
        }
        if (addBtn) addBtn.disabled = false;
        if (buyBtn) buyBtn.disabled = false;
      });
  }

  function handlePdpAddToCart() {
    pdpAddToCart(false);
  }

  function handlePdpCheckout() {
    pdpAddToCart(true);
  }
</script>

{% schema %}
{
  "name": "Custom product details",
  "presets": [
    {
      "name": "Custom product details"
    }
  ]
}
{% endschema %}
