<script>
  var pdpProductList = [
    {
      title: "Royal Flapping Bird™ — Interactive Cat Toy",
      price: "$39.99",
      compare: "$59.99",
      images: [
        "https://cdn.shopify.com/s/files/1/0674/7147/4819/files/Screenshot_2026-07-27_at_5.46.53_pm.png?v=1785138530",
        "https://cdn.shopify.com/s/files/1/0674/7147/4819/files/Screenshot_2026-07-27_at_5.48.14_pm.png?v=1785138539",
        "https://cdn.shopify.com/s/files/1/0674/7147/4819/files/Screenshot_2026-07-27_at_5.47.53_pm.png?v=1785138537",
        "https://cdn.shopify.com/s/files/1/0674/7147/4819/files/Sfac75b7551e64d68a4cb8d046ae3821aF.webp?v=1767934933"
      ],
      desc: "The Royal Flapping Bird™ triggers your cat's natural hunting instincts — realistic flapping wings, lifelike chirping sounds, and unpredictable movement. USB rechargeable with catnip pouch included!"
    },
    {
      title: "Pets Water Bottle Portable Travel Cup with Food Dispenser",
      price: "$29.99",
      compare: "$44.99",
      images: [
        "https://cdn.shopify.com/s/files/1/0674/7147/4819/files/S57bfe3f12ed94b34900d27ced7dc719cU.webp?v=1765941139",
        "https://cdn.shopify.com/s/files/1/0674/7147/4819/files/Sa10184da43db43ceb5b618b43b4e3859f.webp?v=1765941139",
        "https://cdn.shopify.com/s/files/1/0674/7147/4819/files/Sd7de7ec4524740d985d026dc63816d6d7.webp?v=1765941139"
      ],
      desc: "Keep your pet hydrated & fed during outdoor walks with 100% food-grade leak-proof water cup and food compartment. 2-in-1 container!"
    },
    {
      title: "Royal Pet Cozy Bed — Calming Ultra-Soft Plush",
      price: "$49.99",
      compare: "$79.99",
      images: [
        "https://cdn.shopify.com/s/files/1/0674/7147/4819/files/b95b69183a986803d32f849725aafdcd.webp?v=1776385988",
        "https://cdn.shopify.com/s/files/1/0674/7147/4819/files/S6ed178911c1e4f2ab42ff29031814af7X.webp?v=1776385988",
        "https://cdn.shopify.com/s/files/1/0674/7147/4819/files/S4c01d37d5a5040138787c5cf253a51c5Y.webp?v=1776385988"
      ],
      desc: "Ultra-soft premium plush bed with calming raised edges. Over 561 pet owners made the switch for anxiety relief and joint support!"
    }
  ];

  function switchPdpImage(idx) {
    var mainImg = document.getElementById('pdpMainImg');
    var thumbs = document.querySelectorAll('.pet-pdp-thumb-box');
    if (thumbs[idx]) {
      thumbs.forEach(function(t){ t.classList.remove('active'); });
      thumbs[idx].classList.add('active');
      mainImg.src = thumbs[idx].querySelector('img').src;
    }
  }

  function adjustPdpQty(delta) {
    var valEl = document.getElementById('pdpQtyVal');
    var currentVal = parseInt(valEl.innerText) || 1;
    var newVal = Math.max(1, currentVal + delta);
    valEl.innerText = newVal;
  }

  function togglePdpAccordion(btn) {
    var item = btn.parentElement;
    var isOpen = item.classList.contains('active');
    item.classList.toggle('active');
    btn.querySelector('span:last-child').innerText = isOpen ? '+' : '−';
  }

  function loadPdpProduct(index) {
    var item = pdpProductList[index];
    document.getElementById('pdpBreadcrumbTitle').innerText = item.title;
    document.getElementById('pdpTitle').innerText = item.title;
    document.getElementById('pdpPrice').innerText = item.price;
    document.getElementById('pdpCompare').innerText = item.compare;
    document.getElementById('pdpFullDesc').innerText = item.desc;
    document.getElementById('pdpMainImg').src = item.images[0];

    var thumbsCol = document.getElementById('pdpThumbsCol');
    thumbsCol.innerHTML = '';
    item.images.forEach(function(src, i) {
      var box = document.createElement('div');
      box.className = 'pet-pdp-thumb-box' + (i === 0 ? ' active' : '');
      box.innerHTML = '<img src="' + src + '" alt="thumb">';
      box.onclick = function() { switchPdpImage(i); };
      thumbsCol.appendChild(box);
    });

    document.title = item.title + " – Pets Royalty";
    window.scrollTo({ top: 0, behavior: 'smooth' });
  }

  function handlePdpAddToCart() {
    var toast = document.getElementById('pdpCartToast');
    if (toast) {
      toast.style.display = 'block';
      toast.innerText = '✅ Item added to cart! Opening Stripe Checkout...';
    }
    setTimeout(function() {
      window.location.href = '/checkout';
    }, 800);
  }

  function handlePdpCheckout() {
    window.location.href = '/checkout';
  }

  document.addEventListener('DOMContentLoaded', function() {
    var path = window.location.pathname.toLowerCase();
    if (path.indexOf('water-bottle') !== -1) {
      loadPdpProduct(1);
    } else if (path.indexOf('cozy-bed') !== -1 || path.indexOf('royal-pet-cozy-bed') !== -1) {
      loadPdpProduct(2);
    } else {
      loadPdpProduct(0);
    }
  });
</script>

