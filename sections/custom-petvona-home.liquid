  <div class="pv-container">

    <!-- ===== MISSION ===== -->
    <section class="pv-mission">
      <div>
        <p class="pv-mission__text">{{ 'custom.pv_home.mission_text' | t }}</p>
        <a href="/pages/about-us" class="pv-link-arrow" style="margin-top: 1.6rem;">{{ 'custom.pv_home.learn_more' | t }} →</a>
      </div>
      <div class="pv-mission__circle">
        <img src="{{ 'hero-cat-hammock.jpg' | asset_url }}" alt="{{ 'custom.pv_home.mission_heading' | t }}" loading="lazy">
      </div>
      <h2 class="pv-mission__heading">{{ 'custom.pv_home.mission_heading' | t }}</h2>
    </section>

