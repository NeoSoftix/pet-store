        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
      </button>
      <button type="button" class="pv-hero__arrow pv-hero__arrow--next" aria-label="{{ 'custom.pv_home.aria_next_slide' | t }}" data-pv-hero-next>
        <svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
      </button>

      <div class="pv-hero__slide pv-hero__slide--1 is-active" data-pv-hero-slide>
        <div class="pv-hero__content-wrap">
          <div class="pv-hero__content">
            <svg class="pv-hero__paw" viewBox="0 0 24 24" fill="currentColor">
              <path d="M12 2a3 3 0 0 0-3 3c0 .38.08.73.21 1.06A4.98 4.98 0 0 0 5 11c0 2.76 2.24 5 5 5h4c2.76 0 5-2.24 5-5 0-2.27-1.52-4.18-3.61-4.75.13-.33.21-.68.21-1.06a3 3 0 0 0-3-3zm-6 9c0 1.65 1.35 3 3 3h6c1.65 0 3-1.35 3-3 0-1.65-1.35-3-3-3h-6c-1.65 0-3 1.35-3 3z"/>
            </svg>
            <h1 class="pv-hero__heading">{{ 'custom.pv_home.hero_heading' | t }}</h1>
            <a href="/collections/all" class="pv-hero__cta">
              <span>🐕 {{ 'custom.pv_home.hero_cta' | t }}</span>
              <span class="pv-hero__cta-icon">
                <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M17 7H8M17 7v9"/></svg>
              </span>
            </a>
            <p class="pv-hero__subheading">{{ 'custom.pv_home.hero_card2_title' | t }}</p>
